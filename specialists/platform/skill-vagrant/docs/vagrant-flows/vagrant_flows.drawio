        <UserObject id="e2e-a-box-archive-1-l" label="&lt;b&gt;4.1&lt;/b&gt;" tooltip="&lt;b&gt;4.1 Archive a box before the registry closes: step 1 installed&lt;/b&gt;&lt;br&gt;&lt;div&gt;Is the box version installed here?&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Installed boxes&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;" tags="flow-box-archive family-boxes step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-boxes"><mxGeometry x="83" y="1107" width="38" height="16" as="geometry"/></mxCell></UserObject>
