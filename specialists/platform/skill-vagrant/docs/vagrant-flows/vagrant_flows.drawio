        <UserObject id="e2e-a-provider-select-5" label="" tooltip="&lt;b&gt;1.5 Which provider runs vagrant up: step 5 blocks&lt;/b&gt;&lt;br&gt;&lt;div&gt;The first config.vm.provider block that is usable here, in file order.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vagrant 2.4.9&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Vagrantfile&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Vagrant 2.4.9 (no arrow)&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;1.1 flag:&lt;/b&gt; Was &lt;font face=&quot;Courier New&quot;&gt;--provider&lt;/font&gt; given?&lt;/li&gt;&lt;li&gt;&lt;b&gt;1.2 use-flag:&lt;/b&gt; Uses that provider; later commands remember it.&lt;/li&gt;&lt;li&gt;&lt;b&gt;1.3 env:&lt;/b&gt; Is VAGRANT_​DEFAULT_​PROVIDER set?&lt;/li&gt;&lt;li&gt;&lt;b&gt;1.4 use-env:&lt;/b&gt; Uses the provider the variable names.&lt;/li&gt;&lt;/ul&gt;" tags="flow-provider-select family-lifecycle step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.7222;entryX=1;entryY=0.3889;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-lifecycle" source="e2e-c-vagrant" target="e2e-c-vagrantfile"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1066" y="713"/><mxPoint x="1066" y="1577"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-provider-select-6" label="" tooltip="&lt;b&gt;1.6 Which provider runs vagrant up: step 6 use-block&lt;/b&gt;&lt;br&gt;&lt;div&gt;Uses that block&amp;#x27;s provider.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vagrantfile&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Vagrant 2.4.9&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="flow-provider-select family-lifecycle step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.1667;entryX=1;entryY=0.7963;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-lifecycle" source="e2e-c-vagrantfile" target="e2e-c-vagrant"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1042" y="1553"/><mxPoint x="1042" y="737"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-first-up-1" label="" tooltip='&lt;b&gt;2.1 First vagrant up of a new machine: step 1 pin&lt;/b&gt;&lt;br&gt;&lt;div&gt;Box and exact &lt;font face="Courier New"&gt;box_version&lt;/font&gt; are read.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vagrant 2.4.9&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Vagrantfile&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;' tags="flow-first-up family-lifecycle step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.6481;entryX=1;entryY=0.6111;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-lifecycle" source="e2e-c-vagrant" target="e2e-c-vagrantfile"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="689"/><mxPoint x="1090" y="1601"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-first-up-2" label="" tooltip="&lt;b&gt;2.2 First vagrant up of a new machine: step 2 box&lt;/b&gt;&lt;br&gt;&lt;div&gt;Pinned box installed?&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vagrantfile&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Installed boxes&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;" tags="flow-first-up family-lifecycle step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.8333;entryX=1;entryY=0.8333;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-lifecycle" source="e2e-c-vagrantfile" target="e2e-c-box-store"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-first-up-3" label="" tooltip='&lt;b&gt;2.3 First vagrant up of a new machine: step 3 fetch&lt;/b&gt;&lt;br&gt;&lt;div&gt;Downloads the box (until 2026-12-31; then from the archive&amp;#x27;s &lt;font face="Courier New"&gt;metadata.json&lt;/font&gt;).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Installed boxes&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; HCP Vagrant box registry&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; HTTPS&lt;/div&gt;' tags="flow-first-up family-lifecycle step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.6111;entryX=0;entryY=0.8846;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-lifecycle" source="e2e-c-box-store" target="e2e-c-registry"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="596" y="1601"/><mxPoint x="596" y="1499"/><mxPoint x="1018" y="1499"/><mxPoint x="1018" y="393"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-first-up-4" label="" tooltip="&lt;b&gt;2.4 First vagrant up of a new machine: step 4 clone&lt;/b&gt;&lt;br&gt;&lt;div&gt;Linked clone of the box image; customize post-import runs once.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; HCP Vagrant box registry&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; vagrant-parallels 2.4.10&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;" tags="flow-first-up family-lifecycle step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.1154;entryX=1;entryY=0.1364;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-lifecycle" source="e2e-c-registry" target="e2e-c-vp"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-first-up-5" label="" tooltip="&lt;b&gt;2.5 First vagrant up of a new machine: step 5 boot&lt;/b&gt;&lt;br&gt;&lt;div&gt;customize pre-boot, boot, post-boot, wait for SSH, post-comm.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; vagrant-parallels 2.4.10&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Parallels Desktop 27 (prlctl)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;" tags="flow-first-up family-lifecycle step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.6818;entryX=0;entryY=0.1029;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-lifecycle" source="e2e-c-vp" target="e2e-c-parallels"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="345"/><mxPoint x="970" y="545"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-first-up-6" label="" tooltip="&lt;b&gt;2.6 First vagrant up of a new machine: step 6 configure&lt;/b&gt;&lt;br&gt;&lt;div&gt;Hostname, network interfaces, synced folders.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Parallels Desktop 27 (prlctl)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Lab VM (guest)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; SSH&lt;/div&gt;" tags="flow-first-up family-lifecycle step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.72;entryX=1;entryY=0.3889;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-lifecycle" source="e2e-c-parallels" target="e2e-c-guest"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1392" y="653"/><mxPoint x="1392" y="1577"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-triage-parallels-guest" label="" tooltip="&lt;b&gt;Lab VM (guest): not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; Parallels Desktop 27 (prlctl)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why:&lt;/b&gt; &lt;b&gt;A guest that does not answer&lt;/b&gt; depends on Lab VM (guest)&lt;/div&gt;" tags="flow-wedged-guest family-triage connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#a0522d;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=1;exitY=0.5829;entryX=1;entryY=0.6111;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-triage" source="e2e-c-parallels" target="e2e-c-guest"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1416" y="629"/><mxPoint x="1416" y="1601"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-wedged-guest-1" label="" tooltip="&lt;b&gt;3.1 A guest that does not answer: step 1 capture&lt;/b&gt;&lt;br&gt;&lt;div&gt;prlctl capture (VBoxManage screenshotpng, or the QEMU serial socket).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Parallels Desktop 27 (prlctl)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;" tags="flow-wedged-guest family-triage step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#a0522d;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.25;entryX=0;entryY=0.5143;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-triage" source="e2e-c-agent" target="e2e-c-parallels"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="596" y="581"/><mxPoint x="596" y="861"/><mxPoint x="898" y="861"/><mxPoint x="898" y="617"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-wedged-guest-2" label="" tooltip="&lt;b&gt;3.2 A guest that does not answer: step 2 what&lt;/b&gt;&lt;br&gt;&lt;div&gt;What does the console show?&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Parallels Desktop 27 (prlctl)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="flow-wedged-guest family-triage step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#a0522d;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.6514;entryX=1;entryY=0.3929;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-triage" source="e2e-c-parallels" target="e2e-c-agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="922" y="641"/><mxPoint x="922" y="885"/><mxPoint x="428" y="885"/><mxPoint x="428" y="605"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-wedged-guest-4" label="" tooltip="&lt;b&gt;3.4 A guest that does not answer: step 4 record&lt;/b&gt;&lt;br&gt;&lt;div&gt;Keep the PNG as the result; reset or roll back only with approval.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; manual&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow):&lt;/b&gt; &lt;b&gt;3.3 wait:&lt;/b&gt; Guest is up; retry exec with a deadline until Tools answer.&lt;/div&gt;" tags="flow-wedged-guest family-triage step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#a0522d;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.8929;entryX=0;entryY=0.3462;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-triage" source="e2e-c-agent" target="e2e-c-operator"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="689"/><mxPoint x="150" y="997"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-wedged-guest-5" label="" tooltip='&lt;b&gt;3.5 A guest that does not answer: step 5 status&lt;/b&gt;&lt;br&gt;&lt;div&gt;prlctl status; a suspended VM starts, or stop &lt;font face="Courier New"&gt;--drop-state&lt;/font&gt;.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Parallels Desktop 27 (prlctl)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-wedged-guest family-triage step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#a0522d;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.7308;entryX=0;entryY=0.7886;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-triage" source="e2e-c-operator" target="e2e-c-parallels"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="596" y="1057"/><mxPoint x="596" y="909"/><mxPoint x="970" y="909"/><mxPoint x="970" y="665"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-boxes-agent-operator" label="" tooltip="&lt;b&gt;Operator: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why:&lt;/b&gt; &lt;b&gt;Archive a box before the registry closes&lt;/b&gt; is owned by Operator&lt;/div&gt;" tags="flow-box-archive family-boxes connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=0;exitY=0.75;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-boxes" source="e2e-c-agent" target="e2e-c-operator"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="126" y="665"/><mxPoint x="126" y="1021"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-boxes-box-store-box-archive" label="" tooltip="&lt;b&gt;Box archive: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; Installed boxes&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why:&lt;/b&gt; &lt;b&gt;Restore a pinned box from the archive&lt;/b&gt; depends on Box archive&lt;/div&gt;" tags="flow-box-restore family-boxes connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=0;exitY=0.7222;entryX=0;entryY=0.2333;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-boxes" source="e2e-c-box-store" target="e2e-c-box-archive"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="1613"/><mxPoint x="150" y="1712"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-box-archive-1" label="" tooltip="&lt;b&gt;4.1 Archive a box before the registry closes: step 1 installed&lt;/b&gt;&lt;br&gt;&lt;div&gt;Is the box version installed here?&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Installed boxes&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;" tags="flow-box-archive family-boxes step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.6071;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-boxes" source="e2e-c-agent" target="e2e-c-box-store"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="102" y="641"/><mxPoint x="102" y="1589"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-box-archive-2" label="" tooltip="&lt;b&gt;4.2 Archive a box before the registry closes: step 2 repackage&lt;/b&gt;&lt;br&gt;&lt;div&gt;vagrant box repackage writes package.box to the archive.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Installed boxes&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Vagrant 2.4.9&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;" tags="flow-box-archive family-boxes step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.1667;entryX=0;entryY=0.6852;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-boxes" source="e2e-c-box-store" target="e2e-c-vagrant"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="524" y="1553"/><mxPoint x="524" y="701"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-box-archive-3" label="" tooltip="&lt;b&gt;4.3 Archive a box before the registry closes: step 3 download&lt;/b&gt;&lt;br&gt;&lt;div&gt;Streams the provider file straight to the archive (no home-disk use).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vagrant 2.4.9&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; HCP Vagrant box registry&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; HTTPS&lt;/div&gt;" tags="flow-box-archive family-boxes step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.1296;entryX=0;entryY=0.4231;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-boxes" source="e2e-c-vagrant" target="e2e-c-registry"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="922" y="521"/><mxPoint x="922" y="321"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-box-archive-4" label="" tooltip="&lt;b&gt;4.4 Archive a box before the registry closes: step 4 length&lt;/b&gt;&lt;br&gt;&lt;div&gt;Bytes equal Content-Length?&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; HCP Vagrant box registry&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="flow-box-archive family-boxes step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.2692;entryX=1;entryY=0.1071;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-boxes" source="e2e-c-registry" target="e2e-c-agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="898" y="297"/><mxPoint x="898" y="445"/><mxPoint x="596" y="445"/><mxPoint x="596" y="557"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-box-archive-6" label="" tooltip='&lt;b&gt;4.6 Archive a box before the registry closes: step 6 hash&lt;/b&gt;&lt;br&gt;&lt;div&gt;sha256 beside the file; &lt;font face="Courier New"&gt;metadata.json&lt;/font&gt; names version, provider, architecture.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Box archive&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow):&lt;/b&gt; &lt;b&gt;4.5 retry:&lt;/b&gt; Keeps the .part file and fails the item; a re-run fetches it again.&lt;/div&gt;' tags="flow-box-archive family-boxes step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.3214;entryX=0;entryY=0.7667;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-boxes" source="e2e-c-agent" target="e2e-c-box-archive"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="54" y="593"/><mxPoint x="54" y="1760"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-box-archive-7" label="" tooltip="&lt;b&gt;4.7 Archive a box before the registry closes: step 7 verify&lt;/b&gt;&lt;br&gt;&lt;div&gt;Size, published checksum and a full tar read for every file.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Box archive&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;" tags="flow-box-archive family-boxes step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.5;entryX=0;entryY=0.4643;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-boxes" source="e2e-c-box-archive" target="e2e-c-agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="78" y="1736"/><mxPoint x="78" y="617"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-box-restore-1" label="" tooltip='&lt;b&gt;5.1 Restore a pinned box from the archive: step 1 check&lt;/b&gt;&lt;br&gt;&lt;div&gt;shasum &lt;font face="Courier New"&gt;-a&lt;/font&gt; 256 &lt;font face="Courier New"&gt;-c&lt;/font&gt; package.box.sha256&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vagrant 2.4.9&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; manual&lt;/div&gt;' tags="flow-box-restore family-boxes step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.463;entryX=1;entryY=0.1154;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-boxes" source="e2e-c-vagrant" target="e2e-c-operator"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="452" y="629"/><mxPoint x="452" y="961"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-box-restore-2" label="" tooltip='&lt;b&gt;5.2 Restore a pinned box from the archive: step 2 how&lt;/b&gt;&lt;br&gt;&lt;div&gt;Added from &lt;font face="Courier New"&gt;metadata.json&lt;/font&gt; or a bare file?&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Vagrant 2.4.9&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;' tags="flow-box-restore family-boxes step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.2692;entryX=0;entryY=0.537;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-boxes" source="e2e-c-operator" target="e2e-c-vagrant"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="476" y="985"/><mxPoint x="476" y="653"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-box-restore-3" label="" tooltip="&lt;b&gt;5.3 Restore a pinned box from the archive: step 3 version-zero&lt;/b&gt;&lt;br&gt;&lt;div&gt;Box recorded as version 0; a pinned Vagrantfile does not match it.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vagrant 2.4.9&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Installed boxes&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;" tags="flow-box-restore family-boxes step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.7593;entryX=1;entryY=0.3889;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-boxes" source="e2e-c-vagrant" target="e2e-c-box-store"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="548" y="725"/><mxPoint x="548" y="1577"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-clone-identity-2" label="" tooltip='&lt;b&gt;6.2 A linked clone and its identity: step 2 same&lt;/b&gt;&lt;br&gt;&lt;div&gt;Clone boots with the source&amp;#x27;s machine-id, so DHCP gives it the same address.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Parallels Desktop 27 (prlctl)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Lab VM (guest)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Parallels Desktop 27 (prlctl) (no arrow):&lt;/b&gt; &lt;b&gt;6.1 stop:&lt;/b&gt; Source stopped; clone &lt;font face="Courier New"&gt;--linked&lt;/font&gt;; new MAC with &lt;font face="Courier New"&gt;--mac&lt;/font&gt; auto.&lt;/div&gt;' tags="flow-clone-identity family-identity step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.8571;entryX=1;entryY=0.1667;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-identity" source="e2e-c-parallels" target="e2e-c-guest"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1368" y="677"/><mxPoint x="1368" y="1553"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-clone-identity-3" label="" tooltip="&lt;b&gt;6.3 A linked clone and its identity: step 3 choice&lt;/b&gt;&lt;br&gt;&lt;div&gt;Must the clone share the source&amp;#x27;s network?&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Lab VM (guest)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; manual&lt;/div&gt;" tags="flow-clone-identity family-identity step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.8333;entryX=1;entryY=0.8846;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-identity" source="e2e-c-guest" target="e2e-c-operator"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="874" y="1625"/><mxPoint x="874" y="1475"/><mxPoint x="596" y="1475"/><mxPoint x="596" y="1081"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-clone-identity-4" label="" tooltip="&lt;b&gt;6.4 A linked clone and its identity: step 4 isolate&lt;/b&gt;&lt;br&gt;&lt;div&gt;Disconnect the shared adapters; reach the clone by prlctl exec only.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Parallels Desktop 27 (prlctl)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;" tags="flow-clone-identity family-identity step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.5769;entryX=0;entryY=0.3771;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-identity" source="e2e-c-operator" target="e2e-c-parallels"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="572" y="1033"/><mxPoint x="572" y="837"/><mxPoint x="874" y="837"/><mxPoint x="874" y="593"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-clone-identity-5" label="" tooltip='&lt;b&gt;6.5 A linked clone and its identity: step 5 reset&lt;/b&gt;&lt;br&gt;&lt;div&gt;truncate &lt;font face="Courier New"&gt;/etc/machine-id&lt;/font&gt;, reboot; systemd commits a new id and the clone gets a new lease.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Parallels Desktop 27 (prlctl)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Lab VM (guest)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-clone-identity family-identity step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.4457;entryX=1;entryY=0.8333;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-identity" source="e2e-c-parallels" target="e2e-c-guest"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1440" y="605"/><mxPoint x="1440" y="1625"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-provider-select-5-l" label="&lt;b&gt;1.5&lt;/b&gt;" tooltip="&lt;b&gt;1.5 Which provider runs vagrant up: step 5 blocks&lt;/b&gt;&lt;br&gt;&lt;div&gt;The first config.vm.provider block that is usable here, in file order.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vagrant 2.4.9&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Vagrantfile&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Vagrant 2.4.9 (no arrow)&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;1.1 flag:&lt;/b&gt; Was &lt;font face=&quot;Courier New&quot;&gt;--provider&lt;/font&gt; given?&lt;/li&gt;&lt;li&gt;&lt;b&gt;1.2 use-flag:&lt;/b&gt; Uses that provider; later commands remember it.&lt;/li&gt;&lt;li&gt;&lt;b&gt;1.3 env:&lt;/b&gt; Is VAGRANT_​DEFAULT_​PROVIDER set?&lt;/li&gt;&lt;li&gt;&lt;b&gt;1.4 use-env:&lt;/b&gt; Uses the provider the variable names.&lt;/li&gt;&lt;/ul&gt;" tags="flow-provider-select family-lifecycle step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-lifecycle"><mxGeometry x="1047" y="1137" width="38" height="16" as="geometry"/></mxCell></UserObject>
