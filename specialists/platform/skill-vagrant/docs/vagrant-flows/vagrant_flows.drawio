        <mxCell id="e2e-leg-boxes-s" value="" style="rounded=0;html=1;fillColor=#1b7a3a;strokeColor=none;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="1939" width="40" height="3" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-boxes-t" value="&lt;b&gt;Boxes:&lt;/b&gt; Archive a box before the registry closes; Restore a pinned box from the archive" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="70" y="1929" width="1404" height="24" as="geometry"/></mxCell>
