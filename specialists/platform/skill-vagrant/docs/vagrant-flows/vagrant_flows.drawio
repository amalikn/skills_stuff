        <UserObject id="box-restore-s-check" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;1. check&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;shasum -a 256 -c package.box.sha256&lt;br&gt; &lt;br&gt;&lt;i&gt;via manual&lt;/i&gt;' tooltip='&lt;b&gt;5.1 check (Operator)&lt;/b&gt;&lt;br&gt;&lt;div&gt;shasum &lt;font face="Courier New"&gt;-a&lt;/font&gt; 256 &lt;font face="Courier New"&gt;-c&lt;/font&gt; package.box.sha256&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; manual&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=12;spacingLeft=18;spacingRight=18;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="230" y="203" width="220" height="101" as="geometry"/></mxCell></UserObject>
        <UserObject id="box-restore-s-how" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;2. how&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Added from metadata.json or a bare file?&lt;br&gt; &lt;br&gt;&lt;i&gt;via internal&lt;/i&gt;' tooltip="&lt;b&gt;5.2 how (Vagrant 2.4.9)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Added from &lt;font face=&quot;Courier New&quot;&gt;metadata.json&lt;/font&gt; or a bare file?&lt;/div&gt;&lt;div&gt;&lt;b&gt;Branches&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;font face=&quot;Courier New&quot;&gt;metadata.json&lt;/font&gt; -&amp;gt; versioned&lt;/li&gt;&lt;li&gt;bare file -&amp;gt; version-zero&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="decision"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rhombus;align=center;verticalAlign=middle;spacingLeft=72;spacingRight=72;spacingTop=0;spacingLeft=75;spacingRight=75;spacingTop=0;spacingBottom=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="530" y="332" width="300" height="178" as="geometry"/></mxCell></UserObject>
        <UserObject id="box-restore-s-version-zero" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;3. version-zero&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;• Box recorded as version 0&lt;br&gt;• a pinned Vagrantfile does not match it.&lt;br&gt; &lt;br&gt;&lt;i&gt;via file&lt;/i&gt;' tooltip="&lt;b&gt;5.3 version-zero (Installed boxes)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Box recorded as version 0; a pinned Vagrantfile does not match it.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=1;absoluteArcSize=1;arcSize=36;spacingLeft=14;spacingRight=12;spacingTop=8;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="971" y="567" width="220" height="120" as="geometry"/></mxCell></UserObject>
