        <UserObject id="e2e-a-box-archive-3-l" label="&lt;b&gt;4.3&lt;/b&gt;" tooltip="&lt;b&gt;4.3 Archive a box before the registry closes: step 3 download&lt;/b&gt;&lt;br&gt;&lt;div&gt;Streams the provider file straight to the archive (no home-disk use).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vagrant 2.4.9&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; HCP Vagrant box registry&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; HTTPS&lt;/div&gt;" tags="flow-box-archive family-boxes step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-boxes"><mxGeometry x="1004" y="313" width="38" height="16" as="geometry"/></mxCell></UserObject>
