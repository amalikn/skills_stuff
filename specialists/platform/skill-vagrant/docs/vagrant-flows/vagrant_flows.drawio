        <UserObject id="e2e-a-box-archive-6-l" label="&lt;b&gt;4.6&lt;/b&gt;" tooltip='&lt;b&gt;4.6 Archive a box before the registry closes: step 6 hash&lt;/b&gt;&lt;br&gt;&lt;div&gt;sha256 beside the file; &lt;font face="Courier New"&gt;metadata.json&lt;/font&gt; names version, provider, architecture.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Box archive&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow):&lt;/b&gt; &lt;b&gt;4.5 retry:&lt;/b&gt; Keeps the .part file and fails the item; a re-run fetches it again.&lt;/div&gt;' tags="flow-box-archive family-boxes step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-boxes"><mxGeometry x="35" y="1168.5" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-box-archive-7-l" label="&lt;b&gt;4.7&lt;/b&gt;" tooltip="&lt;b&gt;4.7 Archive a box before the registry closes: step 7 verify&lt;/b&gt;&lt;br&gt;&lt;div&gt;Size, published checksum and a full tar read for every file.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Box archive&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;" tags="flow-box-archive family-boxes step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-boxes"><mxGeometry x="59" y="1336.3" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-box-restore-1-l" label="&lt;b&gt;5.1&lt;/b&gt;" tooltip='&lt;b&gt;5.1 Restore a pinned box from the archive: step 1 check&lt;/b&gt;&lt;br&gt;&lt;div&gt;shasum &lt;font face="Courier New"&gt;-a&lt;/font&gt; 256 &lt;font face="Courier New"&gt;-c&lt;/font&gt; package.box.sha256&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vagrant 2.4.9&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; manual&lt;/div&gt;' tags="flow-box-restore family-boxes step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-boxes"><mxGeometry x="433" y="787" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-box-restore-2-l" label="&lt;b&gt;5.2&lt;/b&gt;" tooltip='&lt;b&gt;5.2 Restore a pinned box from the archive: step 2 how&lt;/b&gt;&lt;br&gt;&lt;div&gt;Added from &lt;font face="Courier New"&gt;metadata.json&lt;/font&gt; or a bare file?&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Vagrant 2.4.9&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;' tags="flow-box-restore family-boxes step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-boxes"><mxGeometry x="457" y="811" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-box-restore-3-l" label="&lt;b&gt;5.3&lt;/b&gt;" tooltip="&lt;b&gt;5.3 Restore a pinned box from the archive: step 3 version-zero&lt;/b&gt;&lt;br&gt;&lt;div&gt;Box recorded as version 0; a pinned Vagrantfile does not match it.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vagrant 2.4.9&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Installed boxes&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;" tags="flow-box-restore family-boxes step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-boxes"><mxGeometry x="529" y="1143" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-clone-identity-2-l" label="&lt;b&gt;6.2&lt;/b&gt;" tooltip='&lt;b&gt;6.2 A linked clone and its identity: step 2 same&lt;/b&gt;&lt;br&gt;&lt;div&gt;Clone boots with the source&amp;#x27;s machine-id, so DHCP gives it the same address.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Parallels Desktop 27 (prlctl)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Lab VM (guest)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Parallels Desktop 27 (prlctl) (no arrow):&lt;/b&gt; &lt;b&gt;6.1 stop:&lt;/b&gt; Source stopped; clone &lt;font face="Courier New"&gt;--linked&lt;/font&gt;; new MAC with &lt;font face="Courier New"&gt;--mac&lt;/font&gt; auto.&lt;/div&gt;' tags="flow-clone-identity family-identity step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-identity"><mxGeometry x="1349" y="975.6" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-clone-identity-3-l" label="&lt;b&gt;6.3&lt;/b&gt;" tooltip="&lt;b&gt;6.3 A linked clone and its identity: step 3 choice&lt;/b&gt;&lt;br&gt;&lt;div&gt;Must the clone share the source&amp;#x27;s network?&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Lab VM (guest)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; manual&lt;/div&gt;" tags="flow-clone-identity family-identity step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-identity"><mxGeometry x="577" y="1270" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-clone-identity-4-l" label="&lt;b&gt;6.4&lt;/b&gt;" tooltip="&lt;b&gt;6.4 A linked clone and its identity: step 4 isolate&lt;/b&gt;&lt;br&gt;&lt;div&gt;Disconnect the shared adapters; reach the clone by prlctl exec only.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Parallels Desktop 27 (prlctl)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;" tags="flow-clone-identity family-identity step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#f4f6f9;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-identity"><mxGeometry x="704" y="829" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-clone-identity-5-l" label="&lt;b&gt;6.5&lt;/b&gt;" tooltip='&lt;b&gt;6.5 A linked clone and its identity: step 5 reset&lt;/b&gt;&lt;br&gt;&lt;div&gt;truncate &lt;font face="Courier New"&gt;/etc/machine-id&lt;/font&gt;, reboot; systemd commits a new id and the clone gets a new lease.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Parallels Desktop 27 (prlctl)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Lab VM (guest)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-clone-identity family-identity step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-identity"><mxGeometry x="1421" y="1107" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <mxCell id="e2e-leg-title" value="&lt;b&gt;Legend: flow families&lt;/b&gt; (one layer each)" style="text;html=1;align=left;fontSize=14;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="1839" width="600" height="24" as="geometry"/></mxCell>
