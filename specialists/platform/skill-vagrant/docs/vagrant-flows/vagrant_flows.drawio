  <diagram id="flow-provider-select" name="1. Which provider runs vagrant up">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="provider-select-head" label="&lt;b&gt;1. Which provider runs vagrant up&lt;/b&gt; (custom)&lt;br&gt; &lt;br&gt;Show the order Vagrant uses to pick a provider, so a lab names its own (rule name-the-provider).&lt;br&gt; &lt;br&gt;&lt;b&gt;Trigger:&lt;/b&gt; manual: vagrant up&lt;br&gt;&lt;b&gt;Runs on:&lt;/b&gt; Vagrant 2.4.9 · &lt;b&gt;Owner:&lt;/b&gt; Operator&lt;br&gt;&lt;b&gt;Depends on components:&lt;/b&gt; Vagrantfile, vagrant-parallels 2.4.10, virtualbox provider (built in), vagrant-qemu 0.7.0, vagrant-libvirt 0.12.2&lt;br&gt; &lt;br&gt;[back to Overview]" link="data:page/id,overview"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="2589" height="149" as="geometry"/></mxCell></UserObject>
        <UserObject id="flow-provider-select-back" label="‹ E2E page" link="data:page/id,end-to-end" tooltip="Back to this flow's End-to-end page"><mxCell style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontSize=11;align=center;verticalAlign=middle;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2619" y="20" width="100" height="22" as="geometry"/></mxCell></UserObject>
        <mxCell id="provider-select-lane-0" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="189" width="2589" height="250" as="geometry"/></mxCell>
        <UserObject id="provider-select-lanehead-0" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;Vagrant 2.4.9&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;tool&lt;/i&gt;&lt;br&gt; &lt;br&gt;/opt/vagrant (BUSL 1.1 release)' tooltip='&lt;b&gt;Vagrant 2.4.9 (tool)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; &lt;font face="Courier New"&gt;/opt/vagrant&lt;/font&gt; (BUSL 1.1 release)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; vagrant &lt;font face="Courier New"&gt;--version&lt;/font&gt;; vagrant plugin list&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;rounded=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="189" width="190" height="250" as="geometry"/></mxCell></UserObject>
        <mxCell id="provider-select-lane-1" value="" style="rounded=0;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;opacity=35;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="439" width="2589" height="206" as="geometry"/></mxCell>
        <UserObject id="provider-select-lanehead-1" label="" tooltip='&lt;b&gt;Vagrantfile (store)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; &lt;font face="Courier New"&gt;vagrant_stuff&lt;/font&gt; canonical, byte-identical project copy&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; lint passes; copy-check passes&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;fontSize=11;arcSize=8;rounded=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="439" width="190" height="206" as="geometry"/></mxCell></UserObject>
        <UserObject id="provider-select-lanehead-1-shape" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;Vagrantfile&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;store&lt;/i&gt;&lt;br&gt; &lt;br&gt;vagrant_stuff canonical, byte-identical project copy' tooltip='&lt;b&gt;Vagrantfile (store)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; &lt;font face="Courier New"&gt;vagrant_stuff&lt;/font&gt; canonical, byte-identical project copy&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; lint passes; copy-check passes&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;fontSize=11;arcSize=8;fontSize=10;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;verticalAlign=middle;spacingTop=16;spacingBottom=2;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="26" y="485" width="178" height="114" as="geometry"/></mxCell></UserObject>
        <UserObject id="provider-select-s-flag" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;1. flag&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Was --provider given?&lt;br&gt; &lt;br&gt;&lt;i&gt;via internal&lt;/i&gt;' tooltip="&lt;b&gt;1.1 flag (Vagrant 2.4.9)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Was &lt;font face=&quot;Courier New&quot;&gt;--provider&lt;/font&gt; given?&lt;/div&gt;&lt;div&gt;&lt;b&gt;Branches&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;yes -&amp;gt; use-flag&lt;/li&gt;&lt;li&gt;no -&amp;gt; env&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="decision"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rhombus;align=center;verticalAlign=middle;spacingLeft=72;spacingRight=72;spacingTop=0;spacingLeft=65;spacingRight=65;spacingTop=0;spacingBottom=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="230" y="238" width="260" height="152" as="geometry"/></mxCell></UserObject>
