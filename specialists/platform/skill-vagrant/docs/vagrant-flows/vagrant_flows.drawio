        <UserObject id="clone-identity-s-same" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;2. same&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Clone boots with the source&amp;#x27;s machine-id, so DHCP gives it the same address.&lt;br&gt; &lt;br&gt;&lt;i&gt;via internal&lt;/i&gt;' tooltip="&lt;b&gt;6.2 same (Lab VM (guest))&lt;/b&gt;&lt;br&gt;&lt;div&gt;Clone boots with the source&amp;#x27;s machine-id, so DHCP gives it the same address.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="530" y="454" width="220" height="114" as="geometry"/></mxCell></UserObject>
        <UserObject id="clone-identity-s-choice" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;3. choice&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Must the clone share the source&amp;#x27;s network?&lt;br&gt; &lt;br&gt;&lt;i&gt;via manual&lt;/i&gt;' tooltip="&lt;b&gt;6.3 choice (Operator)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Must the clone share the source&amp;#x27;s network?&lt;/div&gt;&lt;div&gt;&lt;b&gt;Branches&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;no -&amp;gt; isolate&lt;/li&gt;&lt;li&gt;yes -&amp;gt; reset&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; manual&lt;/div&gt;" tags="decision"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rhombus;align=center;verticalAlign=middle;spacingLeft=72;spacingRight=72;spacingTop=0;spacingLeft=75;spacingRight=75;spacingTop=0;spacingBottom=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="830" y="599" width="300" height="178" as="geometry"/></mxCell></UserObject>
        <UserObject id="clone-identity-s-isolate" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;4. isolate&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;• Disconnect the shared adapters&lt;br&gt;• reach the clone by prlctl exec only.&lt;br&gt; &lt;br&gt;&lt;i&gt;via CLI&lt;/i&gt;' tooltip="&lt;b&gt;6.4 isolate (Parallels Desktop 27 (prlctl))&lt;/b&gt;&lt;br&gt;&lt;div&gt;Disconnect the shared adapters; reach the clone by prlctl exec only.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dfe7f3;strokeColor=#3d5a80;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=1;absoluteArcSize=1;arcSize=36;spacingLeft=14;spacingRight=12;spacingTop=8;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="1210" y="253" width="220" height="120" as="geometry"/></mxCell></UserObject>
