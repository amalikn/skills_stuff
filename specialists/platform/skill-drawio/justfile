# The pack's own offline contract and engine tests
test: _require-venv
    @{{py}} -m unittest discover -s tests -p 'test_*.py' -b

# The engine tests under every Python that mise has installed from 3.11 up: projects run the engine with their own interpreter
test-matrix:
    #!/usr/bin/env bash
    set -uo pipefail
    rc=0; ran=0
    for v in 3.11 3.12 3.13 3.14; do
      where=$(mise where "python@$v" 2>/dev/null) || { echo "python $v: not installed through mise, NOT TESTED"; continue; }
      bin="$where/bin/python3"
      [ -x "$bin" ] || { echo "python $v: no interpreter at $bin, NOT TESTED"; continue; }
      ran=$((ran + 1))
      if "$bin" -m unittest discover -s tests -p 'test_helpers.py' >/dev/null 2>&1; then echo "python $v: OK"; else echo "python $v: FAIL"; rc=1; fi
    done
    [ "$ran" -gt 0 ] || { echo "no interpreter from 3.11 up is installed through mise" >&2; exit 1; }
    exit $rc

