        <mxCell id="1" parent="0"/>
        <UserObject id="checkout-head" label="&lt;b&gt;1. Checkout&lt;/b&gt; (custom)&lt;br&gt; &lt;br&gt;A customer pays for a basket and gets a confirmation e-mail.&lt;br&gt; &lt;br&gt;&lt;b&gt;Trigger:&lt;/b&gt; button: Pay now on the basket page&lt;br&gt;&lt;b&gt;Runs on:&lt;/b&gt; Web app · &lt;b&gt;Owner:&lt;/b&gt; Orders API&lt;br&gt;&lt;b&gt;Budget:&lt;/b&gt; under 3 s to the confirmation page&lt;br&gt;&lt;b&gt;Depends on components:&lt;/b&gt; Session cache, Payment API key, Orders database, Job queue&lt;br&gt;&lt;b&gt;Credentials:&lt;/b&gt; payment API key&lt;br&gt; &lt;br&gt;[back to Overview]" link="data:page/id,overview"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1990" height="179" as="geometry"/></mxCell></UserObject>
