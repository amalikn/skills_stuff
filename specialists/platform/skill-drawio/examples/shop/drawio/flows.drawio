        <UserObject id="checkout-lanehead-3" label="&lt;b&gt;Payment provider&lt;/b&gt;&lt;br&gt;external&lt;br&gt;payment provider" tooltip="health: provider status page green"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dfe7f3;strokeColor=#3d5a80;fontSize=11;arcSize=8;rounded=0;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="604" width="190" height="120" as="geometry"/></mxCell></UserObject>
