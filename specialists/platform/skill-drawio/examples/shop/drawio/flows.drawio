        <mxCell id="checkout-s-submit" value='&lt;span style="font-size:125%"&gt;&lt;b&gt;1. submit&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Presses Pay now.&lt;br&gt; &lt;br&gt;&lt;i&gt;via HTTP&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=12;spacingLeft=18;spacingRight=18;" vertex="1" parent="1"><mxGeometry x="230" y="233" width="220" height="92" as="geometry"/></mxCell>
        <mxCell id="checkout-n-submit" value="&lt;b&gt;1. submit&lt;/b&gt;" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="207" y="931" width="266" height="35" as="geometry"/></mxCell>
        <UserObject id="checkout-s-page" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;2. page&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Checks the session and posts the basket to the API.&lt;br&gt; &lt;br&gt;&lt;i&gt;via HTTP&lt;/i&gt;' tooltip="reads: session cache"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=10;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="500" y="353" width="220" height="101" as="geometry"/></mxCell></UserObject>
        <mxCell id="checkout-n-page" value="&lt;b&gt;2. page&lt;/b&gt;&lt;br&gt; &lt;br&gt;&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;• session cache&lt;br&gt; &lt;br&gt;&lt;b&gt;Fails&lt;/b&gt;&lt;br&gt;• session expired&lt;br&gt; &lt;br&gt;&lt;b&gt;Look&lt;/b&gt;&lt;br&gt;• web app log" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="477" y="931" width="266" height="170" as="geometry"/></mxCell>
        <UserObject id="checkout-s-charge" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;3. charge&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Creates the order and charges the card.&lt;br&gt; &lt;br&gt;&lt;i&gt;via API + DB&lt;/i&gt;&lt;br&gt;&lt;b&gt;GATE: payment authorised&lt;/b&gt;' tooltip="writes: orders table"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;strokeWidth=2;rhombus;align=center;verticalAlign=middle;spacingLeft=72;spacingRight=72;spacingTop=0;" vertex="1" parent="1"><mxGeometry x="770" y="482" width="380" height="166" as="geometry"/></mxCell></UserObject>
        <mxCell id="checkout-n-charge" value="&lt;b&gt;3. charge&lt;/b&gt;&lt;br&gt; &lt;br&gt;&lt;b&gt;Writes&lt;/b&gt;&lt;br&gt;• orders table&lt;br&gt; &lt;br&gt;&lt;b&gt;Fails&lt;/b&gt;&lt;br&gt;• card declined&lt;br&gt;• provider timeout&lt;br&gt; &lt;br&gt;&lt;b&gt;Look&lt;/b&gt;&lt;br&gt;• API log&lt;br&gt;• provider dashboard" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="747" y="931" width="426" height="200" as="geometry"/></mxCell>
        <mxCell id="checkout-s-provider" value='&lt;span style="font-size:125%"&gt;&lt;b&gt;4. provider&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Authorises the payment.&lt;br&gt; &lt;br&gt;&lt;i&gt;via API&lt;/i&gt;' style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dfe7f3;strokeColor=#3d5a80;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=10;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="1200" y="676" width="220" height="92" as="geometry"/></mxCell>
