        <mxCell id="checkout-n-charge" value="&lt;b&gt;3. charge&lt;/b&gt;&lt;br&gt; &lt;br&gt;&lt;b&gt;Writes&lt;/b&gt;&lt;br&gt;• orders table&lt;br&gt; &lt;br&gt;&lt;b&gt;Fails&lt;/b&gt;&lt;br&gt;• card declined&lt;br&gt;• provider timeout&lt;br&gt; &lt;br&gt;&lt;b&gt;Look&lt;/b&gt;&lt;br&gt;• API log&lt;br&gt;• provider dashboard" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="792" y="961" width="356" height="176" as="geometry"/></mxCell>
