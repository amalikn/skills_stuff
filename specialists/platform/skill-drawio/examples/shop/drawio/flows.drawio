  <diagram id="flow-checkout" name="1. Checkout">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="checkout-head" label="&lt;b&gt;1. Checkout&lt;/b&gt; (custom)&lt;br&gt; &lt;br&gt;A customer pays for a basket and gets a confirmation e-mail.&lt;br&gt; &lt;br&gt;&lt;b&gt;Trigger:&lt;/b&gt; button: Pay now on the basket page&lt;br&gt;&lt;b&gt;Runs on:&lt;/b&gt; Web app · &lt;b&gt;Owner:&lt;/b&gt; Orders API&lt;br&gt;&lt;b&gt;Budget:&lt;/b&gt; under 3 s to the confirmation page&lt;br&gt;&lt;b&gt;Depends on components:&lt;/b&gt; Session cache, Payment API key, Orders database, Job queue&lt;br&gt;&lt;b&gt;Credentials:&lt;/b&gt; payment API key&lt;br&gt; &lt;br&gt;[back to Overview]" link="data:page/id,overview"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1830" height="179" as="geometry"/></mxCell></UserObject>
        <mxCell id="checkout-lane-0" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#000000;opacity=35;" vertex="1" parent="1"><mxGeometry x="20" y="219" width="1830" height="120" as="geometry"/></mxCell>
        <UserObject id="checkout-lanehead-0" label="&lt;b&gt;Customer&lt;/b&gt;&lt;br&gt;person&lt;br&gt;a browser" tooltip="health: can load the home page"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;rounded=0;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="219" width="190" height="120" as="geometry"/></mxCell></UserObject>
        <mxCell id="checkout-lane-1" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;" vertex="1" parent="1"><mxGeometry x="20" y="339" width="1830" height="126" as="geometry"/></mxCell>
        <UserObject id="checkout-lanehead-1" label="&lt;b&gt;Web app&lt;/b&gt;&lt;br&gt;service&lt;br&gt;app servers" tooltip="health: /healthz returns 200"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;rounded=0;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="339" width="190" height="126" as="geometry"/></mxCell></UserObject>
