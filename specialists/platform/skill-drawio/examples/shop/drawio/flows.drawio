        <UserObject id="checkout-s-submit" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;1. submit&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Presses Pay now.&lt;br&gt; &lt;br&gt;&lt;i&gt;via HTTP&lt;/i&gt;' tooltip="&lt;b&gt;1.1 submit (Customer)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Presses Pay now.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; HTTP&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=12;spacingLeft=18;spacingRight=18;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="230" y="233" width="220" height="92" as="geometry"/></mxCell></UserObject>
        <UserObject id="checkout-s-page" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;2. page&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Checks the session and posts the basket to the API.&lt;br&gt; &lt;br&gt;&lt;i&gt;via HTTP&lt;/i&gt;' tooltip="&lt;b&gt;1.2 page (Web app)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Checks the session and posts the basket to the API.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; HTTP&lt;/div&gt;&lt;div&gt;&lt;b&gt;Reads:&lt;/b&gt; session cache&lt;/div&gt;&lt;div&gt;&lt;b&gt;Fails:&lt;/b&gt; session expired&lt;/div&gt;&lt;div&gt;&lt;b&gt;Look:&lt;/b&gt; web app log&lt;/div&gt;" tags="fails"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=10;spacingLeft=16;spacingRight=16;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="530" y="353" width="220" height="101" as="geometry"/></mxCell></UserObject>
        <mxCell id="checkout-n-page" value="&lt;b&gt;2. page&lt;/b&gt;&lt;br&gt; &lt;br&gt;&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;• session cache&lt;br&gt; &lt;br&gt;&lt;b&gt;Fails&lt;/b&gt;&lt;br&gt;• session expired&lt;br&gt; &lt;br&gt;&lt;b&gt;Look&lt;/b&gt;&lt;br&gt;• web app log" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="492" y="961" width="296" height="150" as="geometry"/></mxCell>
