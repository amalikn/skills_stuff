        <UserObject id="checkout-s-enqueue" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;5. enqueue&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Queues the confirmation e-mail.&lt;br&gt; &lt;br&gt;&lt;i&gt;via internal&lt;/i&gt;' tooltip="&lt;b&gt;1.5 enqueue (Orders API)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Queues the confirmation e-mail.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Writes:&lt;/b&gt; job queue&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="1490" y="519" width="220" height="92" as="geometry"/></mxCell></UserObject>
