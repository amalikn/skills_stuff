{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "skill-drawio/flowmap.schema.json",
  "title": "Flow map",
  "description": "Generic schema for a data-first flow map (skill-drawio): every component of a system and every flow through it, step by step, for troubleshooting; rendered to draw.io by the flowmap package. Uses only the keywords skill-drawio's schema_lite.py supports. A project copies this file and narrows it (enums for its kinds, categories, triggers and transports).",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "updated",
    "components",
    "flows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "updated": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "Date the map was last checked against the code."
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "flows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/flow"
      }
    },
    "drawing": {
      "$ref": "#/$defs/drawing"
    },
    "options": {
      "$ref": "#/$defs/options"
    },
    "option_pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/option_page"
      },
      "description": "Older name for decision_pages, still read (page id options-<id>); new maps use decision_pages."
    },
    "decision_pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/option_page"
      },
      "description": "Optional, preferred over option_pages (operator, 2026-10-22: decisions, never options): pages of decisions by subject, drawn after the Overview (after `options` when both are given). Each tab is the page's title as written; page id decisions-<id>."
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "text_list": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "code_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./@-]+(:[A-Za-z_][A-Za-z0-9_.-]*)?$",
      "description": "Repository-relative file, optionally `:symbol` (a def, class, shell function, constant, YAML key or just recipe defined in it)."
    },
    "component": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "group",
        "host",
        "health"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1,
          "description": "What the component is (host, container, service, store, external ...); coloured per kind."
        },
        "group": {
          "type": "string",
          "minLength": 1,
          "description": "The Overview box the component is drawn in (a host, platform or area)."
        },
        "host": {
          "type": "string",
          "minLength": 1,
          "description": "Where it runs or lives."
        },
        "ports": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ]
          }
        },
        "health": {
          "type": "string",
          "minLength": 1,
          "description": "How to tell it is healthy."
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "code": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code_ref"
          }
        },
        "notes": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "shape": {
          "type": "string",
          "enum": [
            "terminator",
            "process",
            "decision",
            "manual-operation",
            "preparation",
            "predefined-process",
            "delay",
            "stored-data",
            "document",
            "data-io",
            "external",
            "person"
          ],
          "description": "Overrides the lane head shape its kind gives."
        }
      }
    },
    "flow": {
      "type": "object",
      "required": [
        "id",
        "title",
        "category",
        "purpose",
        "trigger",
        "runs_on",
        "owner",
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "description": "A grouping of flows (for example native, custom); without a drawing.families block each category is one family."
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "object",
          "required": [
            "kind",
            "detail"
          ],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "description": "What starts it (timer, job, button, api, manual ...)."
            },
            "detail": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "runs_on": {
          "$ref": "#/$defs/id"
        },
        "owner": {
          "$ref": "#/$defs/id"
        },
        "budget": {
          "type": "string"
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "flows": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "components": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/id"
              }
            },
            "credentials": {
              "$ref": "#/$defs/text_list",
              "description": "Names only (vault entry, token variable, bot identity); never a value."
            }
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "actor",
        "action",
        "via"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "actor": {
          "$ref": "#/$defs/id"
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "via": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Transports (API, SSH, DB, file ...)."
        },
        "reads": {
          "$ref": "#/$defs/text_list"
        },
        "writes": {
          "$ref": "#/$defs/text_list"
        },
        "code": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/code_ref"
          }
        },
        "gate": {
          "type": "string",
          "description": "An approval or guard the step waits on."
        },
        "failures": {
          "$ref": "#/$defs/text_list"
        },
        "look": {
          "$ref": "#/$defs/text_list",
          "description": "Where to look: log path, journalctl unit, page path, just recipe."
        },
        "next": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "description": "The steps this one leads to. For a two-way gate the order is the meaning: the first target is the gate passing (drawn Yes, green), the second the gate failing (No, red); name other cases with `when`."
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "shape": {
          "type": "string",
          "enum": [
            "terminator",
            "process",
            "decision",
            "manual-operation",
            "preparation",
            "predefined-process",
            "delay",
            "stored-data",
            "document",
            "data-io",
            "external",
            "person"
          ],
          "description": "Overrides the derived flow page shape (flowmap.shapes)."
        },
        "flow": {
          "$ref": "#/$defs/id",
          "description": "Another flow this step runs: drawn as a predefined process linked to that flow's page."
        },
        "when": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "description": "A decision's case per branch: {target step id: label}; without it a two-way gate's branches read Yes and No (look.branch_labels)."
        }
      }
    },
    "drawing": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional drawing settings; every one has a default derived from the map (flowmap.profile.Profile.from_drawing).",
      "properties": {
        "output": {
          "type": "string",
          "minLength": 1,
          "description": "The .drawio file, relative to the project root."
        },
        "host": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "check": {
          "type": "string",
          "minLength": 1
        },
        "groups_per_row": {
          "type": "integer"
        },
        "group_columns": {
          "type": "object",
          "description": "Overview: {group name: columns} for the grid of boxes with no arrow inside the group (default 3); 1 stacks them vertically.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        },
        "group_layout": {
          "type": "object",
          "description": "Overview: {group name: vertical | horizontal | grid N} for the boxes with no arrow inside the group; the readable form of group_columns (one column, one row, N columns).",
          "additionalProperties": {
            "type": "string",
            "pattern": "^(vertical|horizontal|grid [1-9][0-9]*)$"
          }
        },
        "group_cell": {
          "type": "object",
          "description": "Overview: {group name: [row, column]}, counted from 1, to place a group in the group grid; other groups fill the free cells in map order.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          }
        },
        "default_tier": {
          "type": "integer"
        },
        "band_title": {
          "type": "string",
          "minLength": 1
        },
        "kinds": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "description": "{kind: [fill, stroke]}, in legend order."
        },
        "tiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "groups"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "groups": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "below": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "groups": {
              "$ref": "#/$defs/text_list"
            },
            "kinds": {
              "$ref": "#/$defs/text_list"
            }
          }
        },
        "kind_tier": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "families": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "colour"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "colour": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "flows": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/id"
                }
              }
            }
          }
        },
        "family_by_category": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/id"
          }
        },
        "kind_shapes": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "terminator",
              "process",
              "decision",
              "manual-operation",
              "preparation",
              "predefined-process",
              "delay",
              "stored-data",
              "document",
              "data-io",
              "external",
              "person"
            ]
          },
          "description": "{component kind: lane head shape}."
        },
        "io_vias": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Transports that cross a network: a step using one draws as data in or out."
        },
        "look": {
          "type": "object",
          "additionalProperties": false,
          "description": "The drawing's look; every key optional, defaults in flowmap.profile.DEFAULT_LOOK.",
          "properties": {
            "group_fill": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "shapes": {
              "type": "boolean"
            },
            "step_width": {
              "type": "integer",
              "minimum": 120
            },
            "decision_width": {
              "type": "integer",
              "minimum": 120
            },
            "step_chars": {
              "type": "integer",
              "minimum": 10
            },
            "back_arrows": {
              "type": "string",
              "enum": [
                "short-first",
                "below-lanes"
              ]
            },
            "action_bullets": {
              "type": "boolean"
            },
            "uncross": {
              "type": "string",
              "enum": [
                "on",
                "off"
              ]
            },
            "e2e_layers": {
              "type": "string",
              "enum": [
                "family",
                "flow"
              ],
              "description": "End-to-end colours and layers: one per family (default) or one per flow, so each x of an x.y label has its own colour and layer."
            },
            "connector_width": {
              "type": "number",
              "minimum": 0.5,
              "description": "Stroke width of the End-to-end dashed connectors (a component a flow runs on, is owned by or depends on); default 1.25."
            },
            "e2e_family_pages": {
              "type": "boolean",
              "description": "Also draw one End-to-end page per flow family after the full one: that family's flows and the components they touch, numbered as in the whole map; default false."
            },
            "e2e_step_total": {
              "enum": [false, true, "sub", "sup", "slash"],
              "description": "End-to-end arrow labels add the flow's step count n after x.y: sub (a subscript; true means sub), sup (a superscript) or slash (x.y/n); the legend gives each flow's step count; default false (x.y)."
            },
            "e2e_label_font": {
              "type": "number",
              "minimum": 8,
              "description": "Font size of the End-to-end arrow labels; the label box grows to fit; default 10."
            },
            "e2e_click_isolate": {
              "type": ["boolean", "number"],
              "minimum": 0,
              "maximum": 1,
              "description": "Clicking an End-to-end step arrow, its label or a legend row dims every other flow (a draw.io custom link; Show all flows resets); true dims to 0.15, a number sets the opacity; default false."
            },
            "e2e_family_colours": {
              "enum": ["page", "flow"],
              "description": "Family End-to-end page flow colours (with e2e_layers flow): page restarts the palette on each page so none repeats; flow keeps each flow's full-page colour, repeating past the palette's length; default page."
            }
          }
        }
      }
    },
    "options": {
      "type": "object",
      "required": [
        "title",
        "groups"
      ],
      "additionalProperties": false,
      "description": "Optional: one Options page comparing design choices. Each group is a question; each option shows its flow as a chain of steps, then its pros and cons.",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option_group"
          }
        },
        "decisions": {
          "$ref": "#/$defs/text_list",
          "description": "Decisions taken that belong to no option group; listed with each group's decision in the page's Decisions taken box."
        }
      }
    },
    "option_group": {
      "type": "object",
      "required": [
        "id",
        "title",
        "options"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "type": "string",
          "minLength": 1,
          "description": "What was decided, by whom and when; left out while open."
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option"
          }
        }
      }
    },
    "option": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "steps",
        "pros",
        "cons"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "chosen",
            "evaluate",
            "open",
            "rejected"
          ]
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "string",
              "object"
            ]
          },
          "description": "The option's flow, one box per step, top to bottom: a text, or {text, shape} to name a flowmap.shapes shape (first and last default to terminator)."
        },
        "pros": {
          "$ref": "#/$defs/text_list"
        },
        "cons": {
          "$ref": "#/$defs/text_list"
        }
      }
    },
    "status": {
      "type": "object",
      "required": [
        "state",
        "since"
      ],
      "additionalProperties": false,
      "description": "How real this item is: proposed (an idea), designed (in a governing design), spike-proved (ran in a lab or spike), built (in the product), live (in service). Proposed and designed draw with a dashed border.",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "proposed",
            "designed",
            "spike-proved",
            "built",
            "live"
          ]
        },
        "since": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "The date the item reached this state (for live: when it went into service), never the date someone checked it; put a verification date in evidence."
        },
        "evidence": {
          "type": "string",
          "minLength": 1,
          "description": "Where it is shown: a report, a commit, a design section."
        }
      }
    },
    "option_page": {
      "type": "object",
      "required": [
        "id",
        "title",
        "groups"
      ],
      "additionalProperties": false,
      "description": "One option page of `option_pages`: its id (page `options-<id>`), its title (the tab name), and its groups.",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/option_group"
          }
        },
        "decisions": {
          "$ref": "#/$defs/text_list",
          "description": "Decisions taken that belong to no option group; listed with each group's decision in the page's Decisions taken box."
        }
      }
    }
  }
}
