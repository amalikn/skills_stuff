<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device" compressed="false">
  <diagram id="shapes" name="Shape vocabulary">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t" value="&lt;b&gt;Proposed shape vocabulary for flow pages&lt;/b&gt; (sample for review, 2026-10-21)&lt;br&gt;Standard flowchart symbols (ISO 5807 / draw.io Flowchart set). Third column: how the engine would pick the shape from the map." style="text;html=1;align=left;verticalAlign=top;fontSize=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1100" height="50" as="geometry"/></mxCell>
        <mxCell id="s0" value="&lt;b&gt;Terminator&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=50;" vertex="1" parent="1"><mxGeometry x="30" y="95" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="n0" value="&lt;b&gt;Terminator:&lt;/b&gt; Start or end of a flow: its trigger, or an outcome such as keep or revert&lt;br&gt;&lt;i&gt;Derived from: first step, and a step with no next&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="95" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="s1" value="&lt;b&gt;Process&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="590" y="95" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="n1" value="&lt;b&gt;Process:&lt;/b&gt; A step that does work on the box&lt;br&gt;&lt;i&gt;Derived from: default for a step&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="95" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="s2" value="&lt;b&gt;Decision&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rhombus;" vertex="1" parent="1"><mxGeometry x="30" y="195" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="n2" value="&lt;b&gt;Decision:&lt;/b&gt; A gate: a yes/no check that picks the next step&lt;br&gt;&lt;i&gt;Derived from: a step with a gate&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="195" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="s3" value="&lt;b&gt;Manual operation&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;" vertex="1" parent="1"><mxGeometry x="590" y="195" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="n3" value="&lt;b&gt;Manual operation:&lt;/b&gt; A person acts: operator, technician, NOC&lt;br&gt;&lt;i&gt;Derived from: a step whose actor is a person&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="195" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="s4" value="&lt;b&gt;Preparation&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;" vertex="1" parent="1"><mxGeometry x="30" y="295" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="n4" value="&lt;b&gt;Preparation:&lt;/b&gt; Set-up before the change: arm a timer, record a baseline&lt;br&gt;&lt;i&gt;Derived from: step shape: prepare (in the map)&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="295" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="s5" value="&lt;b&gt;Predefined process&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=process;backgroundOutline=1;" vertex="1" parent="1"><mxGeometry x="590" y="295" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="n5" value="&lt;b&gt;Predefined process:&lt;/b&gt; Runs another flow, which has its own page&lt;br&gt;&lt;i&gt;Derived from: a step that names a flow&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="295" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="s6" value="&lt;b&gt;Delay&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=delay;" vertex="1" parent="1"><mxGeometry x="30" y="395" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="n6" value="&lt;b&gt;Delay:&lt;/b&gt; Waits for time: a timer, a deadline, a retry backoff&lt;br&gt;&lt;i&gt;Derived from: component kind timer&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="395" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="s7" value="&lt;b&gt;Stored data&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;" vertex="1" parent="1"><mxGeometry x="590" y="395" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="n7" value="&lt;b&gt;Stored data:&lt;/b&gt; A store that persists: /data, a database, a partition&lt;br&gt;&lt;i&gt;Derived from: component kind store&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="395" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="s8" value="&lt;b&gt;Document&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=document;boundedLbl=1;size=0.2;" vertex="1" parent="1"><mxGeometry x="30" y="495" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="n8" value="&lt;b&gt;Document:&lt;/b&gt; A file or record written for people or tools: state file, report&lt;br&gt;&lt;i&gt;Derived from: step writes a file named in writes&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="495" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="s9" value="&lt;b&gt;Data in or out&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;" vertex="1" parent="1"><mxGeometry x="590" y="495" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="n9" value="&lt;b&gt;Data in or out:&lt;/b&gt; Data crossing a link: a download, a push, a report sent&lt;br&gt;&lt;i&gt;Derived from: a step whose via is a network transport&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="495" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="s10" value="&lt;b&gt;External system&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;ellipse;shape=cloud;" vertex="1" parent="1"><mxGeometry x="30" y="595" width="150" height="60" as="geometry"/></mxCell>
        <mxCell id="n10" value="&lt;b&gt;External system:&lt;/b&gt; Outside the box: WAN, Teleport cluster, UNC&lt;br&gt;&lt;i&gt;Derived from: component kind external&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="200" y="595" width="360" height="60" as="geometry"/></mxCell>
        <mxCell id="s11" value="" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="590" y="595" width="30" height="60" as="geometry"/></mxCell>
        <mxCell id="n11" value="&lt;b&gt;Person:&lt;/b&gt; Who starts or approves&lt;br&gt;&lt;i&gt;Derived from: component kind person&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="595" width="360" height="60" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="sample-flow" name="x86 swap, drawn with shapes">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="&lt;b&gt;x86: swap, check, keep or revert&lt;/b&gt; (the same flow as page 8, drawn with the shape vocabulary)" style="text;html=1;align=left;fontSize=14;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="900" height="30" as="geometry"/></mxCell>
        <mxCell id="start" value="1. Operator runs smcbox activate with the new site image" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;spacingLeft=30;spacingRight=30;" vertex="1" parent="1"><mxGeometry x="270" y="70" width="320" height="60" as="geometry"/></mxCell>
        <mxCell id="arm" value="2. Record reach before; arm the revert timer; link the new image" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=hexagon;perimeter=hexagonPerimeter2;fixedSize=1;" vertex="1" parent="1"><mxGeometry x="300" y="170" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="refresh" value="3. Refresh confext (--noexec=false)" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="300" y="270" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="netdevs" value="4. Rebuild changed VLAN, bond and bridge devices" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="restart" value="5. netplan apply; restart dhcpd, Unbound, squid" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=0;" vertex="1" parent="1"><mxGeometry x="300" y="470" width="260" height="60" as="geometry"/></mxCell>
        <mxCell id="check" value="6. Health passes within the deadline?" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rhombus;" vertex="1" parent="1"><mxGeometry x="300" y="570" width="260" height="110" as="geometry"/></mxCell>
        <mxCell id="keep" value="7. Keep: record the new version as current" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="310" y="720" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="revert" value="8. Revert to the previous version" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;rounded=1;arcSize=50;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="620" y="720" width="240" height="60" as="geometry"/></mxCell>
        <mxCell id="state" value="state file" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=document;boundedLbl=1;size=0.2;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="480" y="840" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="store" value="/data/confexts" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e6e6e6;strokeColor=#4d4d4d;" vertex="1" parent="1"><mxGeometry x="680" y="160" width="170" height="70" as="geometry"/></mxCell>
        <mxCell id="timer" value="Revert timer (deadline + 120 s)" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=delay;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="720" y="330" width="200" height="60" as="geometry"/></mxCell>
        <mxCell id="wan" value="WAN targets" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;ellipse;shape=cloud;fillColor=#dfe7f3;strokeColor=#3d5a80;" vertex="1" parent="1"><mxGeometry x="10" y="540" width="170" height="80" as="geometry"/></mxCell>
        <mxCell id="op" value="" style="whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;" vertex="1" parent="1"><mxGeometry x="160" y="75" width="30" height="50" as="geometry"/></mxCell>
        <mxCell id="e-start" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=0;" edge="1" parent="1" source="start" target="arm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-arm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=0;" edge="1" parent="1" source="arm" target="refresh"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-refresh" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=0;" edge="1" parent="1" source="refresh" target="netdevs"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-netdevs" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=0;" edge="1" parent="1" source="netdevs" target="restart"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-restart" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=0;" edge="1" parent="1" source="restart" target="check"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-yes" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=0;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="check" target="keep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-no" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=0;exitX=1;exitY=0.5;entryX=0.25;entryY=0;" edge="1" parent="1" source="check" target="revert"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w-keep" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=0;dashed=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="keep" target="state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w-revert" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=0;dashed=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="revert" target="state"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w-store" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=0;dashed=1;" edge="1" parent="1" source="arm" target="store"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="w-timer" value="if the process dies" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=0;dashed=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="timer" target="revert"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="r-wan" value="reach" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=0;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="check" target="wan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="op-start" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=16;fontStyle=1;labelBackgroundColor=#ffffff;edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;fontSize=11;fontStyle=0;" edge="1" parent="1" source="op" target="start"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
