# Build the flow map from its parts, then render the drawing (writes goal-guard-flows/goal_guard_flows.yaml and .drawio only; skill-drawio engine).
# Edit goal-guard-flows/parts/*.yaml, never the two generated files.
flows:
    @{{drawio_py}} "{{drawio}}/assemble_flowmap.py" --master goal-guard-flows/parts/master.yaml --out goal-guard-flows/goal_guard_flows.yaml --write
    @{{drawio_py}} "{{drawio}}/render_flowmap.py" --root goal-guard-flows --map goal_guard_flows.yaml --write

# The map matches its parts, the drawing matches the map, and the routed pages pass every layout audit (read-only; part of `just check`).
flows-check:
    @{{drawio_py}} "{{drawio}}/assemble_flowmap.py" --master goal-guard-flows/parts/master.yaml --out goal-guard-flows/goal_guard_flows.yaml
    @{{drawio_py}} "{{drawio}}/render_flowmap.py" --root goal-guard-flows --map goal_guard_flows.yaml
    @{{drawio_py}} "{{drawio}}/render_flowmap.py" --root goal-guard-flows --map goal_guard_flows.yaml --audit

