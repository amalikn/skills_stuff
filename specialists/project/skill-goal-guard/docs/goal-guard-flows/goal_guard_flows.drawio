        <UserObject id="handoff-s-propose" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;1. propose&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Writes the proposal (task, criterion or blocker, smallest step, stop condition, files).&lt;br&gt; &lt;br&gt;&lt;i&gt;via file&lt;/i&gt;' tooltip="&lt;b&gt;1.1 propose (Coding agent)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Writes the proposal (task, criterion or blocker, smallest step, stop condition, files).&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Reads&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;MVP contract&lt;/li&gt;&lt;li&gt;Vikunja task&lt;/li&gt;&lt;/ul&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=1;absoluteArcSize=1;arcSize=36;spacingLeft=14;spacingRight=12;spacingTop=8;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="230" y="203" width="220" height="120" as="geometry"/></mxCell></UserObject>
