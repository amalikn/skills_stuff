        <UserObject id="e2e-a-handoff-2" label="" tooltip='&lt;b&gt;1.2 Handoff to a coding agent: step 2 assess&lt;/b&gt;&lt;br&gt;&lt;div&gt;Decides it in the order of &lt;font face="Courier New"&gt;decision-rules.md&lt;/font&gt; (see the Decision order page).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Coding agent&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_guard.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-handoff family-scope step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.3182;entryX=0;entryY=0.2333;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-scope" source="e2e-c-agent" target="e2e-c-assess"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-handoff-5" label="" tooltip="&lt;b&gt;1.5 Handoff to a coding agent: step 5 park&lt;/b&gt;&lt;br&gt;&lt;div&gt;Keeps the current task; the idea stays in the log as a parked idea.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;goal_guard.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Coding agent&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in goal_guard.py (no arrow)&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;1.3 record:&lt;/b&gt; With &lt;font face=&quot;Courier New&quot;&gt;--apply&lt;/font&gt;, appends the verdict (or the parked idea) to decisions.jsonl.&lt;/li&gt;&lt;li&gt;&lt;b&gt;1.4 verdict:&lt;/b&gt; Which verdict?&lt;/li&gt;&lt;/ul&gt;" tags="flow-handoff family-scope step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.3667;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-scope" source="e2e-c-assess" target="e2e-c-agent"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-handoff-6" label="" tooltip="&lt;b&gt;1.6 Handoff to a coding agent: step 6 review&lt;/b&gt;&lt;br&gt;&lt;div&gt;Decides the trade-off, or approves a new MVP revision through change control.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Coding agent&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Owner&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; manual&lt;/div&gt;" tags="flow-handoff family-scope step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.6818;entryX=1;entryY=0.3261;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-scope" source="e2e-c-agent" target="e2e-c-owner"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="360" y="404"/><mxPoint x="360" y="632"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-handoff-7" label="" tooltip="&lt;b&gt;1.7 Handoff to a coding agent: step 7 work&lt;/b&gt;&lt;br&gt;&lt;div&gt;Does only the smallest step, then attaches evidence per criterion.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Owner&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Coding agent&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="flow-handoff family-scope step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.2391;entryX=1;entryY=0.8636;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-scope" source="e2e-c-owner" target="e2e-c-agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="336" y="608"/><mxPoint x="336" y="428"/></Array></mxGeometry></mxCell></UserObject>
