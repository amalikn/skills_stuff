        <UserObject id="handoff-s-record" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;3. record&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;With --apply, appends the verdict (or the parked idea) to decisions.jsonl.&lt;br&gt; &lt;br&gt;&lt;i&gt;via file&lt;/i&gt;' tooltip='&lt;b&gt;1.3 record (&lt;font face="Courier New"&gt;goal_guard.py&lt;/font&gt;)&lt;/b&gt;&lt;br&gt;&lt;div&gt;With &lt;font face="Courier New"&gt;--apply&lt;/font&gt;, appends the verdict (or the parked idea) to decisions.jsonl.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Writes:&lt;/b&gt; decisions.jsonl&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="830" y="389" width="220" height="101" as="geometry"/></mxCell></UserObject>
        <mxCell id="handoff-n-record" value="&lt;b&gt;3. record&lt;/b&gt;&lt;br&gt; &lt;br&gt;&lt;b&gt;Writes&lt;/b&gt;&lt;br&gt;• decisions.jsonl" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="792" y="771" width="296" height="72" as="geometry"/></mxCell>
        <UserObject id="handoff-s-verdict" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;4. verdict&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Which verdict?&lt;br&gt; &lt;br&gt;&lt;i&gt;via internal&lt;/i&gt;' tooltip="&lt;b&gt;1.4 verdict (&lt;font face=&quot;Courier New&quot;&gt;goal_guard.py&lt;/font&gt;)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Which verdict?&lt;/div&gt;&lt;div&gt;&lt;b&gt;Branches&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;PROCEED -&amp;gt; work&lt;/li&gt;&lt;li&gt;PARK -&amp;gt; park&lt;/li&gt;&lt;li&gt;REVIEW or BLOCK -&amp;gt; review&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="decision"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rhombus;align=center;verticalAlign=middle;spacingLeft=72;spacingRight=72;spacingTop=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="1130" y="373" width="240" height="133" as="geometry"/></mxCell></UserObject>
        <UserObject id="handoff-s-park" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;5. park&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;• Keeps the current task&lt;br&gt;• the idea stays in the log as a parked idea.&lt;br&gt; &lt;br&gt;&lt;i&gt;via internal&lt;/i&gt;' tooltip="&lt;b&gt;1.5 park (Coding agent)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Keeps the current task; the idea stays in the log as a parked idea.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=1;absoluteArcSize=1;arcSize=36;spacingLeft=14;spacingRight=12;spacingTop=8;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="1466" y="203" width="220" height="120" as="geometry"/></mxCell></UserObject>
