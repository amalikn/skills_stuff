        <UserObject id="handoff-s-assess" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;2. assess&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Decides it in the order of decision-rules.md (see the Decision order page).&lt;br&gt; &lt;br&gt;&lt;i&gt;via CLI&lt;/i&gt;' tooltip="&lt;b&gt;1.2 assess (&lt;font face=&quot;Courier New&quot;&gt;goal_guard.py&lt;/font&gt;)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Decides it in the order of &lt;font face=&quot;Courier New&quot;&gt;decision-rules.md&lt;/font&gt; (see the Decision order page).&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Reads&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;font face=&quot;Courier New&quot;&gt;.gg/mvp.yaml&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Courier New&quot;&gt;mappings.yaml&lt;/font&gt;&lt;/li&gt;&lt;li&gt;decisions.jsonl&lt;/li&gt;&lt;li&gt;Vikunja tasks&lt;/li&gt;&lt;/ul&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="530" y="382.5" width="220" height="114" as="geometry"/></mxCell></UserObject>
