        <mxCell id="e2e-shp-process-t" value="Process: a step that does work" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="430" y="1720" width="240" height="36" as="geometry"/></mxCell>
