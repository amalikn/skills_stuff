        <UserObject id="e2e-a-restore-2" label="" tooltip='&lt;b&gt;7.2 Clean-instance restore: step 2 clean&lt;/b&gt;&lt;br&gt;&lt;div&gt;Target project holds only tasks Goal Guard restored?&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_​guard_​snapshot.​py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Vikunja test instance&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; API&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in goal_guard_snapshot.py (no arrow):&lt;/b&gt; &lt;b&gt;7.1 verify:&lt;/b&gt; Verifies the snapshot first.&lt;/div&gt;' tags="flow-restore family-resilience step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#a0522d;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.4231;entryX=0;entryY=0.3478;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-resilience" source="e2e-c-snapshot-tool" target="e2e-c-test-instance"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-restore-3" label="" tooltip='&lt;b&gt;7.3 Clean-instance restore: step 3 stop&lt;/b&gt;&lt;br&gt;&lt;div&gt;Refuses: not a clean instance.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vikunja test instance&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_​guard_​snapshot.​py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;' tags="flow-restore family-resilience step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#a0522d;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.5217;entryX=1;entryY=0.5769;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-resilience" source="e2e-c-test-instance" target="e2e-c-snapshot-tool"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-restore-4" label="" tooltip='&lt;b&gt;7.4 Clean-instance restore: step 4 create&lt;/b&gt;&lt;br&gt;&lt;div&gt;With &lt;font face="Courier New"&gt;--apply&lt;/font&gt;, creates the missing tasks (marked) and their relations once.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_​guard_​snapshot.​py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Vikunja test instance&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; API&lt;/div&gt;' tags="flow-restore family-resilience step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#a0522d;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.7308;entryX=0;entryY=0.6957;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-resilience" source="e2e-c-snapshot-tool" target="e2e-c-test-instance"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-restore-5" label="" tooltip='&lt;b&gt;7.5 Clean-instance restore: step 5 readback&lt;/b&gt;&lt;br&gt;&lt;div&gt;Reads everything back and compares counts, fields and relations.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vikunja test instance&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_​guard_​snapshot.​py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; API&lt;/div&gt;' tags="flow-restore family-resilience step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#a0522d;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.8696;entryX=1;entryY=0.8846;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-resilience" source="e2e-c-test-instance" target="e2e-c-snapshot-tool"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-handoff-1-l" label="&lt;b&gt;1.1&lt;/b&gt;" tooltip='&lt;b&gt;1.1 Handoff to a coding agent: step 1 propose&lt;/b&gt;&lt;br&gt;&lt;div&gt;Writes the proposal (task, criterion or blocker, smallest step, stop condition, files).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_guard.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Coding agent&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;' tags="flow-handoff family-scope step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-scope"><mxGeometry x="293" y="324" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-handoff-2-l" label="&lt;b&gt;1.2&lt;/b&gt;" tooltip='&lt;b&gt;1.2 Handoff to a coding agent: step 2 assess&lt;/b&gt;&lt;br&gt;&lt;div&gt;Decides it in the order of &lt;font face="Courier New"&gt;decision-rules.md&lt;/font&gt; (see the Decision order page).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Coding agent&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_guard.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-handoff family-scope step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-scope"><mxGeometry x="293" y="348" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-handoff-5-l" label="&lt;b&gt;1.5&lt;/b&gt;" tooltip="&lt;b&gt;1.5 Handoff to a coding agent: step 5 park&lt;/b&gt;&lt;br&gt;&lt;div&gt;Keeps the current task; the idea stays in the log as a parked idea.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;goal_guard.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Coding agent&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in goal_guard.py (no arrow)&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;1.3 record:&lt;/b&gt; With &lt;font face=&quot;Courier New&quot;&gt;--apply&lt;/font&gt;, appends the verdict (or the parked idea) to decisions.jsonl.&lt;/li&gt;&lt;li&gt;&lt;b&gt;1.4 verdict:&lt;/b&gt; Which verdict?&lt;/li&gt;&lt;/ul&gt;" tags="flow-handoff family-scope step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-scope"><mxGeometry x="293" y="372" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-handoff-6-l" label="&lt;b&gt;1.6&lt;/b&gt;" tooltip="&lt;b&gt;1.6 Handoff to a coding agent: step 6 review&lt;/b&gt;&lt;br&gt;&lt;div&gt;Decides the trade-off, or approves a new MVP revision through change control.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Coding agent&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Owner&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; manual&lt;/div&gt;" tags="flow-handoff family-scope step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-scope"><mxGeometry x="341" y="510" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-handoff-7-l" label="&lt;b&gt;1.7&lt;/b&gt;" tooltip="&lt;b&gt;1.7 Handoff to a coding agent: step 7 work&lt;/b&gt;&lt;br&gt;&lt;div&gt;Does only the smallest step, then attaches evidence per criterion.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Owner&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Coding agent&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="flow-handoff family-scope step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-scope"><mxGeometry x="317" y="537" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-hook-gate-2-l" label="&lt;b&gt;3.2&lt;/b&gt;" tooltip='&lt;b&gt;3.2 Hook gate before an edit: step 2 recognise&lt;/b&gt;&lt;br&gt;&lt;div&gt;A payload it recognises, for a gated file tool?&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Claude Code&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_guard_hook.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Claude Code (no arrow):&lt;/b&gt; &lt;b&gt;3.1 call:&lt;/b&gt; Sends the tool call as JSON on stdin.&lt;/div&gt;' tags="flow-hook-gate family-scope step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-scope"><mxGeometry x="715" y="174" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-whats-next-1-l" label="&lt;b&gt;4.1&lt;/b&gt;" tooltip='&lt;b&gt;4.1 What&amp;#x27;s Next: step 1 ask&lt;/b&gt;&lt;br&gt;&lt;div&gt;Asks for the next action, optionally naming a focus task.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_guard.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Owner&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-whats-next family-focus step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-focus"><mxGeometry x="290.5" y="444" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-whats-next-2-l" label="&lt;b&gt;4.2&lt;/b&gt;" tooltip="&lt;b&gt;4.2 What&amp;#x27;s Next: step 2 read&lt;/b&gt;&lt;br&gt;&lt;div&gt;Returns every task of the linked projects, page by page.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Owner&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Vikunja 2.7.1&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; API&lt;/div&gt;" tags="flow-whats-next family-focus step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-focus"><mxGeometry x="540" y="844" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-whats-next-3-l" label="&lt;b&gt;4.3&lt;/b&gt;" tooltip='&lt;b&gt;4.3 What&amp;#x27;s Next: step 3 filter&lt;/b&gt;&lt;br&gt;&lt;div&gt;Keeps open tasks mapped to accepted criteria with prerequisites done.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vikunja 2.7.1&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_guard.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;' tags="flow-whats-next family-focus step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-focus"><mxGeometry x="739" y="498" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-whats-next-5-l" label="&lt;b&gt;4.5&lt;/b&gt;" tooltip='&lt;b&gt;4.5 What&amp;#x27;s Next: step 5 answer&lt;/b&gt;&lt;br&gt;&lt;div&gt;Gets Now, Project next, Task next, At risk; forecast stays unknown.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_guard.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Owner&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in goal_guard.py (no arrow):&lt;/b&gt; &lt;b&gt;4.4 rank:&lt;/b&gt; Orders by owner focus, deadline pressure, started work, Vikunja priority, due date, task ID.&lt;/div&gt;' tags="flow-whats-next family-focus step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-focus"><mxGeometry x="293" y="505.8" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-milestone-trace-4-l" label="&lt;b&gt;5.4&lt;/b&gt;" tooltip="&lt;b&gt;5.4 Milestone trace and workbook: step 4 review&lt;/b&gt;&lt;br&gt;&lt;div&gt;REVIEW: reconciles the record; nothing is overwritten silently.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;goal_guard_trace.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Owner&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; manual&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in goal_guard_trace.py (no arrow)&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;5.1 plan:&lt;/b&gt; Checks the hub plan against its pinned revision.&lt;/li&gt;&lt;li&gt;&lt;b&gt;5.2 criteria:&lt;/b&gt; Checks the criteria, the target-map target and the Vikunja tasks.&lt;/li&gt;&lt;li&gt;&lt;b&gt;5.3 verified:&lt;/b&gt; Every check passes?&lt;/li&gt;&lt;/ul&gt;" tags="flow-milestone-trace family-trace step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-trace"><mxGeometry x="293" y="648" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-milestone-trace-5-l" label="&lt;b&gt;5.5&lt;/b&gt;" tooltip='&lt;b&gt;5.5 Milestone trace and workbook: step 5 workbook&lt;/b&gt;&lt;br&gt;&lt;div&gt;With &lt;font face="Courier New"&gt;--apply&lt;/font&gt;, writes the workbook sample (internal targets left out).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Owner&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_guard_trace.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;' tags="flow-milestone-trace family-trace step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-trace"><mxGeometry x="293" y="672" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-snapshot-1-l" label="&lt;b&gt;6.1&lt;/b&gt;" tooltip='&lt;b&gt;6.1 Snapshot export: step 1 read&lt;/b&gt;&lt;br&gt;&lt;div&gt;Returns the project&amp;#x27;s tasks and relations.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_​guard_​snapshot.​py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Vikunja 2.7.1&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; API&lt;/div&gt;' tags="flow-snapshot family-resilience step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#a0522d;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-resilience"><mxGeometry x="763" y="790" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-snapshot-2-l" label="&lt;b&gt;6.2&lt;/b&gt;" tooltip='&lt;b&gt;6.2 Snapshot export: step 2 complete&lt;/b&gt;&lt;br&gt;&lt;div&gt;Every page read?&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vikunja 2.7.1&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_​guard_​snapshot.​py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;' tags="flow-snapshot family-resilience step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#a0522d;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-resilience"><mxGeometry x="787" y="814" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-restore-2-l" label="&lt;b&gt;7.2&lt;/b&gt;" tooltip='&lt;b&gt;7.2 Clean-instance restore: step 2 clean&lt;/b&gt;&lt;br&gt;&lt;div&gt;Target project holds only tasks Goal Guard restored?&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_​guard_​snapshot.​py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Vikunja test instance&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; API&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in goal_guard_snapshot.py (no arrow):&lt;/b&gt; &lt;b&gt;7.1 verify:&lt;/b&gt; Verifies the snapshot first.&lt;/div&gt;' tags="flow-restore family-resilience step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#a0522d;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-resilience"><mxGeometry x="754" y="944" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-restore-3-l" label="&lt;b&gt;7.3&lt;/b&gt;" tooltip='&lt;b&gt;7.3 Clean-instance restore: step 3 stop&lt;/b&gt;&lt;br&gt;&lt;div&gt;Refuses: not a clean instance.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vikunja test instance&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_​guard_​snapshot.​py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;' tags="flow-restore family-resilience step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#a0522d;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-resilience"><mxGeometry x="754" y="968" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-restore-4-l" label="&lt;b&gt;7.4&lt;/b&gt;" tooltip='&lt;b&gt;7.4 Clean-instance restore: step 4 create&lt;/b&gt;&lt;br&gt;&lt;div&gt;With &lt;font face="Courier New"&gt;--apply&lt;/font&gt;, creates the missing tasks (marked) and their relations once.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_​guard_​snapshot.​py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Vikunja test instance&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; API&lt;/div&gt;' tags="flow-restore family-resilience step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#a0522d;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-resilience"><mxGeometry x="754" y="992" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-restore-5-l" label="&lt;b&gt;7.5&lt;/b&gt;" tooltip='&lt;b&gt;7.5 Clean-instance restore: step 5 readback&lt;/b&gt;&lt;br&gt;&lt;div&gt;Reads everything back and compares counts, fields and relations.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Vikunja test instance&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;goal_​guard_​snapshot.​py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; API&lt;/div&gt;' tags="flow-restore family-resilience step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#a0522d;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-resilience"><mxGeometry x="754" y="1016" width="38" height="16" as="geometry"/></mxCell></UserObject>
