        <mxCell id="e2e-leg-trace-t" value="&lt;b&gt;Traceability:&lt;/b&gt; Milestone trace and workbook" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="70" y="1556" width="1104" height="24" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-resilience-s" value="" style="rounded=0;html=1;fillColor=#a0522d;strokeColor=none;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="1594" width="40" height="3" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-resilience-t" value="&lt;b&gt;Resilience:&lt;/b&gt; Snapshot export; Clean-instance restore" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="70" y="1584" width="1104" height="24" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-solid" value="&lt;b&gt;Solid arrow, label x.y:&lt;/b&gt; flow x (its number on the Overview) moves to the component acting in its step y; x.1 starts at the component the flow runs on, and a step done by the same component as the step before has no arrow. &lt;b&gt;Dashed line, dot end:&lt;/b&gt; not a step; the flow runs on, is owned by or depends on that component. Hover an arrow for what happens. Arcs mark crossings." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="1618" width="1154" height="56" as="geometry"/></mxCell>
