  <diagram id="flow-handoff" name="1. Handoff to a coding agent">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <UserObject id="handoff-head" label="&lt;b&gt;1. Handoff to a coding agent&lt;/b&gt; (custom)&lt;br&gt; &lt;br&gt;Before an agent starts a piece of work, Goal Guard decides it against the approved MVP and records the verdict.&lt;br&gt; &lt;br&gt;&lt;b&gt;Trigger:&lt;/b&gt; manual: the agent proposes work, or an agent proposes a design enlargement&lt;br&gt;&lt;b&gt;Runs on:&lt;/b&gt; goal_guard.py · &lt;b&gt;Owner:&lt;/b&gt; Owner&lt;br&gt;&lt;b&gt;Depends on components:&lt;/b&gt; .gg/ records, Vikunja 2.7.1, Vikunja API token&lt;br&gt; &lt;br&gt;[back to Overview]" link="data:page/id,overview"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="2466" height="149" as="geometry"/></mxCell></UserObject>
