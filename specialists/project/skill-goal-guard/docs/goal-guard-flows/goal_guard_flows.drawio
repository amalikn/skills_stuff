        <UserObject id="hook-gate-lanehead-1" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;goal_guard_hook.py&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;tool&lt;/i&gt;&lt;br&gt; &lt;br&gt;scripts/​goal_​guard_​hook.​py (DRAFT)' tooltip='&lt;b&gt;&lt;font face="Courier New"&gt;goal_guard_hook.py&lt;/font&gt; (tool)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; &lt;font face="Courier New"&gt;scripts/​goal_​guard_​hook.​py&lt;/font&gt; (DRAFT)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; doctor reports the wiring; one block observed before enforcing&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;rounded=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="379" width="190" height="228" as="geometry"/></mxCell></UserObject>
        <UserObject id="hook-gate-s-call" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;1. call&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Sends the tool call as JSON on stdin.&lt;br&gt; &lt;br&gt;&lt;i&gt;via stdin&lt;/i&gt;' tooltip="&lt;b&gt;3.1 call (Claude Code)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Sends the tool call as JSON on stdin.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; stdin&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dfe7f3;strokeColor=#3d5a80;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=1;absoluteArcSize=1;arcSize=36;spacingLeft=14;spacingRight=12;spacingTop=8;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="230" y="238.5" width="220" height="106" as="geometry"/></mxCell></UserObject>
