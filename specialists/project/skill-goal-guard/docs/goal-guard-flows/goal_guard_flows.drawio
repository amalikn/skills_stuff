        <UserObject id="e2e-a-milestone-trace-4" label="" tooltip="&lt;b&gt;5.4 Milestone trace and workbook: step 4 review&lt;/b&gt;&lt;br&gt;&lt;div&gt;REVIEW: reconciles the record; nothing is overwritten silently.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;goal_guard_trace.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Owner&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; manual&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in goal_guard_trace.py (no arrow)&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;5.1 plan:&lt;/b&gt; Checks the hub plan against its pinned revision.&lt;/li&gt;&lt;li&gt;&lt;b&gt;5.2 criteria:&lt;/b&gt; Checks the criteria, the target-map target and the Vikunja tasks.&lt;/li&gt;&lt;li&gt;&lt;b&gt;5.3 verified:&lt;/b&gt; Every check passes?&lt;/li&gt;&lt;/ul&gt;" tags="flow-milestone-trace family-trace step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.1923;entryX=1;entryY=0.413;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-trace" source="e2e-c-trace" target="e2e-c-owner"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
