        <UserObject id="ov-f-end-to-end" label="&lt;b&gt;End-to-end flow&lt;/b&gt;&lt;br&gt;every component and every flow on one page" link="data:page/id,end-to-end" tooltip="All flows as coloured paths through their components, one layer per family"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4fa;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="150" width="340" height="52" as="geometry"/></mxCell></UserObject>
        <UserObject id="ov-f-handoff" label="&lt;b&gt;1. Handoff to a coding agent&lt;/b&gt;&lt;br&gt;manual · runs on assess · custom" link="data:page/id,flow-handoff" tooltip="Before an agent starts a piece of work, Goal Guard decides it against the approved MVP and records the verdict."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="212" width="340" height="52" as="geometry"/></mxCell></UserObject>
        <UserObject id="ov-f-decide" label="&lt;b&gt;2. Decision order&lt;/b&gt;&lt;br&gt;api · runs on assess · custom" link="data:page/id,flow-decide" tooltip="How one proposal becomes PROCEED, PARK, REVIEW or BLOCK; the first rule that fires wins."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="274" width="340" height="52" as="geometry"/></mxCell></UserObject>
        <UserObject id="ov-f-hook-gate" label="&lt;b&gt;3. Hook gate before an edit&lt;/b&gt;&lt;br&gt;hook · runs on claude-code · custom" link="data:page/id,flow-hook-gate" tooltip="Claude Code asks the hook before Edit, Write, MultiEdit or NotebookEdit; advisory mode warns, blocking mode exits 2."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="336" width="340" height="52" as="geometry"/></mxCell></UserObject>
        <UserObject id="ov-f-whats-next" label="&lt;b&gt;4. What&amp;#x27;s Next&lt;/b&gt;&lt;br&gt;manual · runs on assess · custom" link="data:page/id,flow-whats-next" tooltip="One portfolio focus, each project's next task and the task-level next action, ranked without a weighted score."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="398" width="340" height="52" as="geometry"/></mxCell></UserObject>
        <UserObject id="ov-f-milestone-trace" label="&lt;b&gt;5. Milestone trace and workbook&lt;/b&gt;&lt;br&gt;manual · runs on trace · custom" link="data:page/id,flow-milestone-trace" tooltip="Prove a management milestone links to its plan revision, MVP criteria, target-map target and Vikunja tasks, then export the sample workbook."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="460" width="340" height="52" as="geometry"/></mxCell></UserObject>
        <UserObject id="ov-f-snapshot" label="&lt;b&gt;6. Snapshot export&lt;/b&gt;&lt;br&gt;manual · runs on snapshot-tool · custom" link="data:page/id,flow-snapshot" tooltip="Keep one verified, provider-neutral copy of a project's tasks for offline reading and restore."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="522" width="340" height="52" as="geometry"/></mxCell></UserObject>
