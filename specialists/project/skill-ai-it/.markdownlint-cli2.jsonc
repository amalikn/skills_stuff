// markdownlint config generated by skill-ai-it, aligned to the global markdown rules:
// prose wraps at 200 columns (tables and code exempt) and table layout is owned by the
// markdown-wrap-toc hook (table-reflow), so column-style linting would fight the formatter.
// See: /Volumes/Data/_ai/governance/categories/markdown-guide.md
{
  "config": {
    "default": true,
    "MD013": { "line_length": 200, "tables": false, "code_blocks": false, "headings": false },
    "MD060": false,
    "MD024": { "siblings_only": true },
    // AGENTS.md/CLAUDE.md across this whole governance ecosystem intentionally start with an `@AGENTS.md` /
    // `@../AGENTS.md` import line, not an H1 — that is the convention, not a defect. Without this, MD041 fires on
    // every one of them, forever, in every project.
    "MD041": false
  },
  "ignores": [
    // Generated/support surfaces — never canonical, never linted.
    ".ai-context/**",
    "graphify-out/**",
    ".remember/**",
    ".code-context-notes/**",
    ".staleness-audit/**",
    ".staleness-audit-snapshot-*/**",
    "node_modules/**",
    ".git/**",
    // docs/ holds time-bound one-shot records — authoring prompts, migration write-ups and audit
    // reports named <slug>-YYYYMMDD_hhmm.md. They are evidence of what was decided on a date, not
    // maintained surfaces, and reflowing them would edit the record. 185 of this package's 245
    // lint findings on 2026-09-23 sat in here. A MAINTAINED document must not live in docs/ — put
    // it at the root or under patterns/, where it is linted.
    "docs/**"
    // Add project-specific exemptions below — e.g. immutable baseline/seed docs whose
    // original formatting is a fixed record, or archived research passes that predate
    // this project's markdown conventions:
    // "docs/baseline/<seed-doc>.md",
    // "evidence/archived-docs/**"
  ]
}
