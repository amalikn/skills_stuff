        <UserObject id="bootstrap-lanehead-1" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;Bootstrap and adoption scripts&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;script&lt;/i&gt;&lt;br&gt; &lt;br&gt;scripts/adoption/ (adopt_​governed_​files.​py and others)' tooltip='&lt;b&gt;Bootstrap and adoption scripts (script)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; &lt;font face="Courier New"&gt;scripts/adoption/&lt;/font&gt; (&lt;font face="Courier New"&gt;adopt_​governed_​files.​py&lt;/font&gt; and others)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; plan by default; &lt;font face="Courier New"&gt;--apply&lt;/font&gt; writes managed blocks only&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;rounded=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="303" width="190" height="232" as="geometry"/></mxCell></UserObject>
