        <UserObject id="bootstrap-lanehead-2" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;Project check (just check)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;script&lt;/i&gt;&lt;br&gt; &lt;br&gt;the project&amp;#x27;s justfile and scripts/govcheck/' tooltip='&lt;b&gt;Project check (just check) (script)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; the project&amp;#x27;s justfile and &lt;font face="Courier New"&gt;scripts/govcheck/&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; exit 0&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;rounded=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="535" width="190" height="148" as="geometry"/></mxCell></UserObject>
        <UserObject id="bootstrap-s-ask" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;1. ask&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Asks for a bootstrap or refresh of a project folder.&lt;br&gt; &lt;br&gt;&lt;i&gt;via chat&lt;/i&gt;' tooltip="&lt;b&gt;1.1 ask (Operator)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Asks for a bootstrap or refresh of a project folder.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; chat&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=12;spacingLeft=18;spacingRight=18;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="230" y="188" width="220" height="101" as="geometry"/></mxCell></UserObject>
        <UserObject id="bootstrap-s-plan" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;2. plan&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Plans every governed file the project lacks, from the templates.&lt;br&gt; &lt;br&gt;&lt;i&gt;via internal&lt;/i&gt;' tooltip="&lt;b&gt;1.2 plan (Bootstrap and adoption scripts)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Plans every governed file the project lacks, from the templates.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Reads:&lt;/b&gt; templates&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="530" y="368.5" width="220" height="101" as="geometry"/></mxCell></UserObject>
        <mxCell id="bootstrap-n-plan" value="&lt;b&gt;2. plan&lt;/b&gt;&lt;br&gt; &lt;br&gt;&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;• templates" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="492" y="731" width="296" height="72" as="geometry"/></mxCell>
        <UserObject id="bootstrap-s-apply" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;3. apply&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;With --apply, writes managed blocks and missing files, never over user content.&lt;br&gt; &lt;br&gt;&lt;i&gt;via file&lt;/i&gt;&lt;br&gt;&lt;b&gt;GATE: --apply&lt;/b&gt;' tooltip="&lt;b&gt;1.3 apply (Bootstrap and adoption scripts)&lt;/b&gt;&lt;br&gt;&lt;div&gt;With &lt;font face=&quot;Courier New&quot;&gt;--apply&lt;/font&gt;, writes managed blocks and missing files, never over user content.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Gate:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;--apply&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Writes&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;governed-files&lt;/li&gt;&lt;li&gt;running-records&lt;/li&gt;&lt;/ul&gt;" tags="decision gate"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;strokeWidth=2;rhombus;align=center;verticalAlign=middle;spacingLeft=72;spacingRight=72;spacingTop=0;spacingLeft=95;spacingRight=95;spacingTop=0;spacingBottom=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="830" y="317" width="380" height="204" as="geometry"/></mxCell></UserObject>
        <mxCell id="bootstrap-n-apply" value="&lt;b&gt;3. apply&lt;/b&gt;&lt;br&gt; &lt;br&gt;&lt;b&gt;Writes&lt;/b&gt;&lt;br&gt;• governed-files&lt;br&gt;• running-records" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="792" y="731" width="456" height="85" as="geometry"/></mxCell>
        <UserObject id="bootstrap-s-verify" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;4. verify&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;• Runs the project&amp;#x27;s check&lt;br&gt;• a failure is fixed in the project, not in the check.&lt;br&gt; &lt;br&gt;&lt;i&gt;via internal&lt;/i&gt;' tooltip="&lt;b&gt;1.4 verify (Project check (just check))&lt;/b&gt;&lt;br&gt;&lt;div&gt;Runs the project&amp;#x27;s check; a failure is fixed in the project, not in the check.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=1;absoluteArcSize=1;arcSize=36;spacingLeft=14;spacingRight=12;spacingTop=8;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="1290" y="549" width="220" height="120" as="geometry"/></mxCell></UserObject>
