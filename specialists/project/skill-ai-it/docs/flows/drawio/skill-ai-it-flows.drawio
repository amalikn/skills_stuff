        <UserObject id="e2e-c-history" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;docs/history&lt;/b&gt;&lt;/span&gt;&lt;br&gt;record' tooltip='&lt;b&gt;&lt;font face="Courier New"&gt;docs/history&lt;/font&gt; (record)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; &lt;font face="Courier New"&gt;docs/​history/​&lt;/font&gt;{changelog,scratchpad,roadmap,session-​records,sync}/​ plus &lt;font face="Courier New"&gt;readme.md&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; every archive listed in the generated index&lt;/div&gt;' tags="kind-record group-consumer-project"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;fontSize=11;arcSize=8;fontSize=11;verticalAlign=middle;spacingLeft=6;spacingRight=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="772" y="363" width="210" height="60" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-c-project-check" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;Project check (just check)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;script' tooltip='&lt;b&gt;Project check (just check) (script)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; the project&amp;#x27;s justfile and &lt;font face="Courier New"&gt;scripts/govcheck/&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; exit 0&lt;/div&gt;' tags="kind-script group-consumer-project flow-bootstrap flow-rotate-records flow-history-migrate flow-governance-check flow-project-refresh"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=11;verticalAlign=middle;spacingLeft=6;spacingRight=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="772" y="471" width="210" height="156" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-c-git" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;Git repositories&lt;/b&gt;&lt;/span&gt;&lt;br&gt;external' tooltip='&lt;b&gt;Git repositories (external)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; &lt;font face="Courier New"&gt;skills_stuff&lt;/font&gt; and each project repository&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; clean tree before a migration&lt;/div&gt;' tags="kind-external group-outside"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dfe7f3;strokeColor=#3d5a80;fontSize=11;arcSize=8;fontSize=11;verticalAlign=middle;spacingLeft=6;spacingRight=6;ellipse;shape=cloud;align=center;spacingLeft=30;spacingRight=28;spacingTop=26;align=center;verticalAlign=middle;spacingLeft=34;spacingRight=34;spacingTop=10;spacingBottom=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="446" y="1406" width="210" height="120" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-c-worktree" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;Tagged skill-ai-it worktree (proposed)&lt;/b&gt;&lt;/span&gt;&lt;br&gt;proposed' tooltip="&lt;b&gt;Tagged skill-ai-it worktree (proposed) (proposed)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; git worktree of skill-ai-it at standard-​&amp;lt;version&amp;gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; label and checked-out tag agree&lt;/div&gt;&lt;div&gt;&lt;b&gt;Status:&lt;/b&gt; proposed since 2026-11-11 (plan section 3, version pin)&lt;/div&gt;" tags="kind-proposed group-outside"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;arcSize=8;fontSize=11;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;dashPattern=6 4;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="120" y="1435.5" width="210" height="61" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-bootstrap-1" label="" tooltip="&lt;b&gt;1.1 Bootstrap or refresh a project: step 1 ask&lt;/b&gt;&lt;br&gt;&lt;div&gt;Asks for a bootstrap or refresh of a project folder.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; chat&lt;/div&gt;" tags="flow-bootstrap family-today step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.5;entryX=0;entryY=0.4167;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-today" source="e2e-c-agent" target="e2e-c-operator"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="70" y="773"/><mxPoint x="70" y="1159"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-bootstrap-2" label="" tooltip="&lt;b&gt;1.2 Bootstrap or refresh a project: step 2 plan&lt;/b&gt;&lt;br&gt;&lt;div&gt;Plans every governed file the project lacks, from the templates.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Bootstrap and adoption scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="flow-bootstrap family-today step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.4167;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-today" source="e2e-c-operator" target="e2e-c-adoption"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="364" y="1159"/><mxPoint x="364" y="1038.5"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-bootstrap-4" label="" tooltip='&lt;b&gt;1.4 Bootstrap or refresh a project: step 4 verify&lt;/b&gt;&lt;br&gt;&lt;div&gt;Runs the project&amp;#x27;s check; a failure is fixed in the project, not in the check.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Bootstrap and adoption scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Project check (just check)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Bootstrap and adoption scripts (no arrow):&lt;/b&gt; &lt;b&gt;1.3 apply:&lt;/b&gt; With &lt;font face="Courier New"&gt;--apply&lt;/font&gt;, writes managed blocks and missing files, never over user content.&lt;/div&gt;' tags="flow-bootstrap family-today step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.8846;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-today" source="e2e-c-adoption" target="e2e-c-project-check"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="738" y="1038.5"/><mxPoint x="738" y="609"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-rotate-records-1" label="" tooltip="&lt;b&gt;2.1 Rotate running records: step 1 plan&lt;/b&gt;&lt;br&gt;&lt;div&gt;Picks the entries over budget; open items go to a tracker, not to history.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Record scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="flow-rotate-records family-today step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.2692;entryX=0;entryY=0.7;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-today" source="e2e-c-agent" target="e2e-c-records"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="388" y="737"/><mxPoint x="388" y="405"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-rotate-records-3" label="" tooltip='&lt;b&gt;2.3 Rotate running records: step 3 check&lt;/b&gt;&lt;br&gt;&lt;div&gt;Confirms the records are within budget and the index lists every archive.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Record scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Project check (just check)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Record scripts (no arrow):&lt;/b&gt; &lt;b&gt;2.2 write:&lt;/b&gt; With &lt;font face="Courier New"&gt;--apply&lt;/font&gt;, writes the archive into its kind folder and adds it to the history index.&lt;/div&gt;' tags="flow-rotate-records family-today step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.3;entryX=0;entryY=0.1154;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-today" source="e2e-c-records" target="e2e-c-project-check"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="714" y="381"/><mxPoint x="714" y="489"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-history-migrate-1" label="" tooltip='&lt;b&gt;3.1 Group &lt;font face="Courier New"&gt;docs/history&lt;/font&gt; by kind: step 1 refuse&lt;/b&gt;&lt;br&gt;&lt;div&gt;Refuses when &lt;font face="Courier New"&gt;docs/history&lt;/font&gt; has uncommitted changes.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Record scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;' tags="flow-history-migrate family-today step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.1154;entryX=0;entryY=0.3;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-today" source="e2e-c-agent" target="e2e-c-records"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="364" y="713"/><mxPoint x="364" y="381"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-history-migrate-4" label="" tooltip="&lt;b&gt;3.4 Group &lt;font face=&quot;Courier New&quot;&gt;docs/history&lt;/font&gt; by kind: step 4 verify&lt;/b&gt;&lt;br&gt;&lt;div&gt;Runs the project&amp;#x27;s check; a docs-index check that wants one readme per folder must accept the history index (UNC, 2026-11-11).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Record scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Project check (just check)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Record scripts (no arrow)&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;3.2 move:&lt;/b&gt; With &lt;font face=&quot;Courier New&quot;&gt;--apply&lt;/font&gt;, moves each file with git mv, names unchanged, and repoints references in the project.&lt;/li&gt;&lt;li&gt;&lt;b&gt;3.3 index:&lt;/b&gt; Regenerates the history index, one section per kind, hand descriptions kept.&lt;/li&gt;&lt;/ul&gt;" tags="flow-history-migrate family-today step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.7;entryX=0;entryY=0.2692;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-today" source="e2e-c-records" target="e2e-c-project-check"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="405"/><mxPoint x="690" y="513"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-governance-check-1" label="" tooltip="&lt;b&gt;4.1 Governance check: step 1 run&lt;/b&gt;&lt;br&gt;&lt;div&gt;Runs the project&amp;#x27;s own checks and skill-ai-it&amp;#x27;s checks.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Project check (just check)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="flow-governance-check family-today step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.4231;entryX=0;entryY=0.5769;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-today" source="e2e-c-agent" target="e2e-c-project-check"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="412" y="761"/><mxPoint x="412" y="661"/><mxPoint x="690" y="661"/><mxPoint x="690" y="561"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-governance-check-2" label="" tooltip="&lt;b&gt;4.2 Governance check: step 2 freshness&lt;/b&gt;&lt;br&gt;&lt;div&gt;Flags documents past review, records over budget and files without a header.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Project check (just check)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Check scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="flow-governance-check family-today step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.4231;entryX=1;entryY=0.3;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-today" source="e2e-c-project-check" target="e2e-c-checks"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-standard-release-2" label="" tooltip='&lt;b&gt;5.2 Release a new standard tag (proposed): step 2 compare&lt;/b&gt;&lt;br&gt;&lt;div&gt;Runs every consumer&amp;#x27;s check against the new checkout and compares saved outputs and counts with the last tag.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;consumer_check.py&lt;/font&gt; (proposed)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow):&lt;/b&gt; &lt;b&gt;5.1 edit:&lt;/b&gt; Edits skill-ai-it in its working folder, which no project runs.&lt;/div&gt;' tags="flow-standard-release family-proposed step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.8846;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-proposed" source="e2e-c-agent" target="e2e-c-consumer-check"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="364" y="833"/><mxPoint x="364" y="929.5"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-project-refresh-1" label="" tooltip='&lt;b&gt;6.1 Move a project to the next tag (proposed): step 1 plan&lt;/b&gt;&lt;br&gt;&lt;div&gt;Prints the move from the current tag to the next.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;standard_refresh.py&lt;/font&gt; (proposed)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;' tags="flow-project-refresh family-proposed step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.5769;entryX=0;entryY=0.6967;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-proposed" source="e2e-c-agent" target="e2e-c-refresh"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-project-refresh-3" label="" tooltip='&lt;b&gt;6.3 Move a project to the next tag (proposed): step 3 diff&lt;/b&gt;&lt;br&gt;&lt;div&gt;Runs the check before and after; any difference is listed for the operator.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;standard_refresh.py&lt;/font&gt; (proposed)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Project check (just check)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in standard_refresh.py (proposed) (no arrow):&lt;/b&gt; &lt;b&gt;6.2 move:&lt;/b&gt; With &lt;font face="Courier New"&gt;--apply&lt;/font&gt;, points the project at the new tag&amp;#x27;s worktree and updates standard.version.&lt;/div&gt;' tags="flow-project-refresh family-proposed step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.7308;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-proposed" source="e2e-c-refresh" target="e2e-c-project-check"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="714" y="773"/><mxPoint x="714" y="585"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-conformance-run-1" label="" tooltip='&lt;b&gt;7.1 Conformance across projects (proposed): step 1 read&lt;/b&gt;&lt;br&gt;&lt;div&gt;Reads each project&amp;#x27;s standard block, maps and recipes; runs the CUE pass centrally.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;conformance.py&lt;/font&gt; and &lt;font face="Courier New"&gt;cue_seam.py&lt;/font&gt; (proposed)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;' tags="flow-conformance-run family-proposed step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.7308;entryX=0;entryY=0.2143;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-proposed" source="e2e-c-agent" target="e2e-c-conformance"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="388" y="809"/><mxPoint x="388" y="1135"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-conformance-run-3" label="" tooltip='&lt;b&gt;7.3 Conformance across projects (proposed): step 3 decide&lt;/b&gt;&lt;br&gt;&lt;div&gt;Accepts each undeclared difference as a deviation, or asks for it to be removed.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;conformance.py&lt;/font&gt; and &lt;font face="Courier New"&gt;cue_seam.py&lt;/font&gt; (proposed)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; chat&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in conformance.py and cue_seam.py (proposed) (no arrow):&lt;/b&gt; &lt;b&gt;7.2 report:&lt;/b&gt; Appends one line per project to conformance-runs.jsonl and renders the drift table.&lt;/div&gt;' tags="flow-conformance-run family-proposed step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.7857;entryX=1;entryY=0.75;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-proposed" source="e2e-c-conformance" target="e2e-c-operator"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-bootstrap-1-l" label="&lt;b&gt;1.1&lt;/b&gt;" tooltip="&lt;b&gt;1.1 Bootstrap or refresh a project: step 1 ask&lt;/b&gt;&lt;br&gt;&lt;div&gt;Asks for a bootstrap or refresh of a project folder.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; chat&lt;/div&gt;" tags="flow-bootstrap family-today step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-today"><mxGeometry x="51" y="958" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-bootstrap-2-l" label="&lt;b&gt;1.2&lt;/b&gt;" tooltip="&lt;b&gt;1.2 Bootstrap or refresh a project: step 2 plan&lt;/b&gt;&lt;br&gt;&lt;div&gt;Plans every governed file the project lacks, from the templates.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Bootstrap and adoption scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="flow-bootstrap family-today step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-today"><mxGeometry x="345" y="1090.8" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-bootstrap-4-l" label="&lt;b&gt;1.4&lt;/b&gt;" tooltip='&lt;b&gt;1.4 Bootstrap or refresh a project: step 4 verify&lt;/b&gt;&lt;br&gt;&lt;div&gt;Runs the project&amp;#x27;s check; a failure is fixed in the project, not in the check.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Bootstrap and adoption scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Project check (just check)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Bootstrap and adoption scripts (no arrow):&lt;/b&gt; &lt;b&gt;1.3 apply:&lt;/b&gt; With &lt;font face="Courier New"&gt;--apply&lt;/font&gt;, writes managed blocks and missing files, never over user content.&lt;/div&gt;' tags="flow-bootstrap family-today step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-today"><mxGeometry x="719" y="815.8" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-rotate-records-1-l" label="&lt;b&gt;2.1&lt;/b&gt;" tooltip="&lt;b&gt;2.1 Rotate running records: step 1 plan&lt;/b&gt;&lt;br&gt;&lt;div&gt;Picks the entries over budget; open items go to a tracker, not to history.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Record scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="flow-rotate-records family-today step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-today"><mxGeometry x="369" y="563" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-rotate-records-3-l" label="&lt;b&gt;2.3&lt;/b&gt;" tooltip='&lt;b&gt;2.3 Rotate running records: step 3 check&lt;/b&gt;&lt;br&gt;&lt;div&gt;Confirms the records are within budget and the index lists every archive.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Record scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Project check (just check)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Record scripts (no arrow):&lt;/b&gt; &lt;b&gt;2.2 write:&lt;/b&gt; With &lt;font face="Courier New"&gt;--apply&lt;/font&gt;, writes the archive into its kind folder and adds it to the history index.&lt;/div&gt;' tags="flow-rotate-records family-today step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-today"><mxGeometry x="695" y="427" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-history-migrate-1-l" label="&lt;b&gt;3.1&lt;/b&gt;" tooltip='&lt;b&gt;3.1 Group &lt;font face="Courier New"&gt;docs/history&lt;/font&gt; by kind: step 1 refuse&lt;/b&gt;&lt;br&gt;&lt;div&gt;Refuses when &lt;font face="Courier New"&gt;docs/history&lt;/font&gt; has uncommitted changes.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Record scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;' tags="flow-history-migrate family-today step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-today"><mxGeometry x="345" y="539" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-history-migrate-4-l" label="&lt;b&gt;3.4&lt;/b&gt;" tooltip="&lt;b&gt;3.4 Group &lt;font face=&quot;Courier New&quot;&gt;docs/history&lt;/font&gt; by kind: step 4 verify&lt;/b&gt;&lt;br&gt;&lt;div&gt;Runs the project&amp;#x27;s check; a docs-index check that wants one readme per folder must accept the history index (UNC, 2026-11-11).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Record scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Project check (just check)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Record scripts (no arrow)&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;3.2 move:&lt;/b&gt; With &lt;font face=&quot;Courier New&quot;&gt;--apply&lt;/font&gt;, moves each file with git mv, names unchanged, and repoints references in the project.&lt;/li&gt;&lt;li&gt;&lt;b&gt;3.3 index:&lt;/b&gt; Regenerates the history index, one section per kind, hand descriptions kept.&lt;/li&gt;&lt;/ul&gt;" tags="flow-history-migrate family-today step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-today"><mxGeometry x="671" y="451" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-governance-check-1-l" label="&lt;b&gt;4.1&lt;/b&gt;" tooltip="&lt;b&gt;4.1 Governance check: step 1 run&lt;/b&gt;&lt;br&gt;&lt;div&gt;Runs the project&amp;#x27;s own checks and skill-ai-it&amp;#x27;s checks.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Project check (just check)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="flow-governance-check family-today step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#f4f6f9;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-today"><mxGeometry x="532" y="653" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-governance-check-2-l" label="&lt;b&gt;4.2&lt;/b&gt;" tooltip="&lt;b&gt;4.2 Governance check: step 2 freshness&lt;/b&gt;&lt;br&gt;&lt;div&gt;Flags documents past review, records over budget and files without a header.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Project check (just check)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Check scripts&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;" tags="flow-governance-check family-today step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-today"><mxGeometry x="695" y="529" width="38" height="16" as="geometry"/></mxCell></UserObject>
