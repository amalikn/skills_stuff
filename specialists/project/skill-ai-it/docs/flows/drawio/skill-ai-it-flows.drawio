        <UserObject id="history-migrate-head" label="&lt;b&gt;3. Group docs/history by kind&lt;/b&gt; (custom)&lt;br&gt; &lt;br&gt;Move a project&amp;#x27;s flat rotated records into changelog, scratchpad, roadmap, session-records and sync folders.&lt;br&gt; &lt;br&gt;&lt;b&gt;Trigger:&lt;/b&gt; manual: just -f skill-ai-it/justfile history-migrate &amp;lt;project&amp;gt; [--apply]&lt;br&gt;&lt;b&gt;Runs on:&lt;/b&gt; Agent session · &lt;b&gt;Owner:&lt;/b&gt; Record scripts&lt;br&gt; &lt;br&gt;[back to Overview]" link="data:page/id,overview"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1590" height="134" as="geometry"/></mxCell></UserObject>
