        <UserObject id="project-refresh-s-move" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;2. move&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;With --apply, points the project at the new tag&amp;#x27;s worktree and updates standard.version.&lt;br&gt; &lt;br&gt;&lt;i&gt;via file&lt;/i&gt;&lt;br&gt;&lt;b&gt;GATE: --apply&lt;/b&gt;' tooltip='&lt;b&gt;6.2 move (&lt;font face="Courier New"&gt;standard_refresh.py&lt;/font&gt; (proposed))&lt;/b&gt;&lt;br&gt;&lt;div&gt;With &lt;font face="Courier New"&gt;--apply&lt;/font&gt;, points the project at the new tag&amp;#x27;s worktree and updates standard.version.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Gate:&lt;/b&gt; &lt;font face="Courier New"&gt;--apply&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Writes:&lt;/b&gt; governed-files&lt;/div&gt;' tags="decision gate"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;strokeWidth=2;rhombus;align=center;verticalAlign=middle;spacingLeft=72;spacingRight=72;spacingTop=0;spacingLeft=100;spacingRight=100;spacingTop=0;spacingBottom=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="530" y="203" width="400" height="230" as="geometry"/></mxCell></UserObject>
