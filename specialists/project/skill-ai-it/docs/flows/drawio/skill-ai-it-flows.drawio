        <UserObject id="rotate-records-head" label="&lt;b&gt;2. Rotate running records&lt;/b&gt; (custom)&lt;br&gt; &lt;br&gt;Keep CHANGELOG, SCRATCHPAD and ROADMAP within budget by moving old entries to docs/history.&lt;br&gt; &lt;br&gt;&lt;b&gt;Trigger:&lt;/b&gt; manual: just rotate, or a slurp&amp;#x27;s just budget --apply&lt;br&gt;&lt;b&gt;Runs on:&lt;/b&gt; Agent session · &lt;b&gt;Owner:&lt;/b&gt; Record scripts&lt;br&gt; &lt;br&gt;[back to Overview]" link="data:page/id,overview"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1290" height="134" as="geometry"/></mxCell></UserObject>
