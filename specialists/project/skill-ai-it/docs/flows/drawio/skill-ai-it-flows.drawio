        <UserObject id="e2e-a-project-refresh-3-l" label="&lt;b&gt;6.3&lt;/b&gt;" tooltip='&lt;b&gt;6.3 Move a project to the next tag (proposed): step 3 diff&lt;/b&gt;&lt;br&gt;&lt;div&gt;Runs the check before and after; any difference is listed for the operator.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;standard_refresh.py&lt;/font&gt; (proposed)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Project check (just check)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in standard_refresh.py (proposed) (no arrow):&lt;/b&gt; &lt;b&gt;6.2 move:&lt;/b&gt; With &lt;font face="Courier New"&gt;--apply&lt;/font&gt;, points the project at the new tag&amp;#x27;s worktree and updates standard.version.&lt;/div&gt;' tags="flow-project-refresh family-proposed step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-proposed"><mxGeometry x="695" y="671" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-conformance-run-1-l" label="&lt;b&gt;7.1&lt;/b&gt;" tooltip='&lt;b&gt;7.1 Conformance across projects (proposed): step 1 read&lt;/b&gt;&lt;br&gt;&lt;div&gt;Reads each project&amp;#x27;s standard block, maps and recipes; runs the CUE pass centrally.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;conformance.py&lt;/font&gt; and &lt;font face="Courier New"&gt;cue_seam.py&lt;/font&gt; (proposed)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; internal&lt;/div&gt;' tags="flow-conformance-run family-proposed step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-proposed"><mxGeometry x="369" y="964" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-conformance-run-3-l" label="&lt;b&gt;7.3&lt;/b&gt;" tooltip='&lt;b&gt;7.3 Conformance across projects (proposed): step 3 decide&lt;/b&gt;&lt;br&gt;&lt;div&gt;Accepts each undeclared difference as a deviation, or asks for it to be removed.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;conformance.py&lt;/font&gt; and &lt;font face="Courier New"&gt;cue_seam.py&lt;/font&gt; (proposed)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; chat&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in conformance.py and cue_seam.py (proposed) (no arrow):&lt;/b&gt; &lt;b&gt;7.2 report:&lt;/b&gt; Appends one line per project to conformance-runs.jsonl and renders the drift table.&lt;/div&gt;' tags="flow-conformance-run family-proposed step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-proposed"><mxGeometry x="369" y="1175" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <mxCell id="e2e-leg-title" value="&lt;b&gt;Legend: flow families&lt;/b&gt; (one layer each)" style="text;html=1;align=left;fontSize=14;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="1584" width="600" height="24" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-today-s" value="" style="rounded=0;html=1;fillColor=#1f4e9c;strokeColor=none;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="1628" width="40" height="3" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-today-t" value="&lt;b&gt;Today:&lt;/b&gt; Bootstrap or refresh a project; Rotate running records; Group docs/history by kind; Governance check" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="70" y="1618" width="912" height="24" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-proposed-s" value="" style="rounded=0;html=1;fillColor=#6a3fa0;strokeColor=none;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="1656" width="40" height="3" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-proposed-t" value="&lt;b&gt;Proposed by the 2026-11-11 plan:&lt;/b&gt; Release a new standard tag (proposed); Move a project to the next tag (proposed); Conformance across projects (proposed)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="70" y="1646" width="912" height="24" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-solid" value="&lt;b&gt;Solid arrow, label x.y:&lt;/b&gt; flow x (its number on the Overview) moves to the component acting in its step y; x.1 starts at the component the flow runs on, and a step done by the same component as the step before has no arrow. &lt;b&gt;Dashed line, dot end:&lt;/b&gt; not a step; the flow runs on, is owned by or depends on that component. Hover an arrow for what happens. Arcs mark crossings." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="1680" width="962" height="56" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-title" value="&lt;b&gt;Shapes on this page&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="1752" width="300" height="24" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-person" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="44" y="1782" width="22" height="36" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-person-t" value="Person: who starts or approves (the figure marks the box)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="100" y="1782" width="240" height="36" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-process" value="" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;rounded=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="350" y="1782" width="70" height="36" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-process-t" value="Process: a step that does work" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="430" y="1782" width="240" height="36" as="geometry"/></mxCell>
