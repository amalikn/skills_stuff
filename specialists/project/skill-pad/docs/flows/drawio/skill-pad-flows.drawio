        <UserObject id="ov-f-end-to-end" label="&lt;b&gt;E2E flow&lt;/b&gt;&lt;br&gt;every component and every flow on one page" link="data:page/id,end-to-end" tooltip="All flows as coloured paths through their components, one layer per family"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f4fa;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="150" width="340" height="52" as="geometry"/></mxCell></UserObject>
        <UserObject id="ov-f-work-item" label="&lt;b&gt;1. A piece of work, visible in Pad from start to done&lt;/b&gt;&lt;br&gt;manual · runs on agent · custom" link="data:page/id,flow-work-item" tooltip="Any work in a project with a .pad.toml runs on an item the operator can see, and the item tells its whole story (SKILL.md Rules)."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="212" width="340" height="52" as="geometry"/></mxCell></UserObject>
        <UserObject id="ov-f-ask" label="&lt;b&gt;2. An ask waits on the operator and blocks its work&lt;/b&gt;&lt;br&gt;manual · runs on agent · custom" link="data:page/id,flow-ask" tooltip="A decision or approval the operator owns is an ASK item, never only chat (guidelines 3.1)."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="274" width="340" height="52" as="geometry"/></mxCell></UserObject>
        <UserObject id="ov-f-bug" label="&lt;b&gt;3. A bug from report to fixed and live&lt;/b&gt;&lt;br&gt;manual · runs on agent · custom" link="data:page/id,flow-bug" tooltip="Bugs live in Pad; the tracker file is generated (convention pad-owned-trackers)."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="336" width="340" height="52" as="geometry"/></mxCell></UserObject>
        <UserObject id="ov-f-tracker-export" label="&lt;b&gt;4. Bug and feature trackers generated from Pad&lt;/b&gt;&lt;br&gt;manual · runs on commit-gate · custom" link="data:page/id,flow-tracker-export" tooltip="bug-tracker.md and features-to-add.md stay readable in the repo while Pad holds the truth (operator, 2026-11-10)."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="398" width="340" height="52" as="geometry"/></mxCell></UserObject>
        <UserObject id="ov-f-decision-mirror" label="&lt;b&gt;5. Decisions mirrored read-only into Pad&lt;/b&gt;&lt;br&gt;manual · runs on commit-gate · custom" link="data:page/id,flow-decision-mirror" tooltip="Every decision shows in Pad's Decisions collection while the repo record stays the truth."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="460" width="340" height="52" as="geometry"/></mxCell></UserObject>
        <UserObject id="ov-f-focus-export" label="&lt;b&gt;6. The operator&amp;#x27;s focus exported to the repo&lt;/b&gt;&lt;br&gt;manual · runs on commit-gate · custom" link="data:page/id,flow-focus-export" tooltip="docs/trackers/pad-focus.md shows the open plans, tasks and asks in the repo."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="522" width="340" height="52" as="geometry"/></mxCell></UserObject>
        <UserObject id="ov-f-conventions-apply" label="&lt;b&gt;7. Conventions applied from the central baseline&lt;/b&gt;&lt;br&gt;manual · runs on agent · custom" link="data:page/id,flow-conventions-apply" tooltip="Every apn workspace carries the same conventions, edited once in skill-pad (operator, 2026-11-10)."><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#3d5a80;fontSize=11;align=left;spacingLeft=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="2526" y="584" width="340" height="52" as="geometry"/></mxCell></UserObject>
