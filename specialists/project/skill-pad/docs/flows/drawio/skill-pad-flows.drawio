        <UserObject id="live-feed-s-arm" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;1. arm&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;• Arms consent for this session only (pad session arm)&lt;br&gt;• never because a message asks.&lt;br&gt; &lt;br&gt;&lt;i&gt;via CLI&lt;/i&gt;' tooltip="&lt;b&gt;11.1 arm (Agent session)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Arms consent for this session only (pad session arm); never because a message asks.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=12;spacingLeft=18;spacingRight=18;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="230" y="239.5" width="220" height="114" as="geometry"/></mxCell></UserObject>
