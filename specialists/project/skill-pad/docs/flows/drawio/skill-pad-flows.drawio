        <UserObject id="tracker-export-e-gate-read" label="" tooltip='&lt;b&gt;4.2 read&lt;/b&gt;&lt;br&gt;&lt;div&gt;Lists the collection (&lt;font face="Courier New"&gt;--all&lt;/font&gt; &lt;font face="Courier New"&gt;--full&lt;/font&gt;) and rebuilds each section&amp;#x27;s item tree; an item made in Pad renders its title, its body under it.&lt;/div&gt;&lt;div&gt;&lt;b&gt;After:&lt;/b&gt; 1 gate&lt;/div&gt;&lt;div&gt;&lt;b&gt;Done by:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_tracker.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;endArrow=classic;endFill=1;jumpStyle=arc;jumpSize=6;strokeColor=#000000;exitX=1;exitY=0.5;entryX=0;entryY=0.3299;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="1" source="tracker-export-s-gate" target="tracker-export-s-read"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="296.5"/><mxPoint x="490" y="453.4"/></Array></mxGeometry></mxCell></UserObject>
