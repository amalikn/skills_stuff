        <UserObject id="layout-pass-s-review" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;2. review&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;just spec-words checks every body in the spec keeps every word of the item&amp;#x27;s current body (labels may be added), before applying.&lt;br&gt; &lt;br&gt;&lt;i&gt;via CLI&lt;/i&gt;&lt;br&gt;&lt;b&gt;GATE: 0 items with lost words&lt;/b&gt;' tooltip='&lt;b&gt;8.2 review (&lt;font face="Courier New"&gt;pad_item_check.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_spec_words.py&lt;/font&gt;)&lt;/b&gt;&lt;br&gt;&lt;div&gt;just spec-words checks every body in the spec keeps every word of the item&amp;#x27;s current body (labels may be added), before applying.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Gate:&lt;/b&gt; 0 items with lost words&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Code:&lt;/b&gt; &lt;font face="Courier New"&gt;scripts/​pad_​spec_​words.​py&lt;/font&gt;:​lost&lt;/div&gt;' tags="decision gate"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;strokeWidth=2;rhombus;align=center;verticalAlign=middle;spacingLeft=72;spacingRight=72;spacingTop=0;spacingLeft=105;spacingRight=105;spacingTop=0;spacingBottom=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="530" y="396" width="420" height="230" as="geometry"/></mxCell></UserObject>
