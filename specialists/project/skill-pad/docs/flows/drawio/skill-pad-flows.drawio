  <diagram id="flow-work-item" name="1. A piece of work, visible in Pad from start to done">
    <mxGraphModel grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" style="locked=1;" parent="0"/>
        <UserObject id="flow-work-item-back" label="‹ E2E page" link="data:page/id,end-to-end" tooltip="Back to this flow's E2E page"><mxCell style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontSize=11;align=center;verticalAlign=middle;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="100" height="22" as="geometry"/></mxCell></UserObject>
        <UserObject id="work-item-head" label="&lt;b&gt;1. A piece of work, visible in Pad from start to done&lt;/b&gt; (custom)&lt;br&gt; &lt;br&gt;Any work in a project with a .pad.toml runs on an item the operator can see, and the item tells its whole story (SKILL.md Rules).&lt;br&gt; &lt;br&gt;&lt;b&gt;Trigger:&lt;/b&gt; manual: The operator asks for work in a Pad project&lt;br&gt;&lt;b&gt;Runs on:&lt;/b&gt; Agent session · &lt;b&gt;Owner:&lt;/b&gt; Agent session&lt;br&gt;&lt;b&gt;Budget:&lt;/b&gt; one session or less per task; split a bigger one (split-from)&lt;br&gt;&lt;b&gt;Depends on components:&lt;/b&gt; pad CLI, Pad server, Repo trackers and CHANGELOG&lt;br&gt; &lt;br&gt;[back to Overview]" link="data:page/id,overview"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="2210" height="164" as="geometry"/></mxCell></UserObject>
        <mxCell id="work-item-lane-0" value="" style="rounded=0;html=1;fillColor=#ffffff;strokeColor=#000000;opacity=35;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="234" width="2210" height="258" as="geometry"/></mxCell>
        <UserObject id="work-item-lanehead-0" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;Agent session&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;person&lt;/i&gt;&lt;br&gt; &lt;br&gt;Claude Code or Codex on the Mac' tooltip="&lt;b&gt;Agent session (person)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; Claude Code or Codex on the Mac&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; loads skill-pad and runs pad bootstrap before the first Pad action&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;rounded=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=10;spacingRight=40;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="234" width="190" height="258" as="geometry"/></mxCell></UserObject>
        <mxCell id="work-item-lanehead-0-icon" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="176" y="242" width="22" height="40" as="geometry"/></mxCell>
        <mxCell id="work-item-lane-1" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="492" width="2210" height="142" as="geometry"/></mxCell>
        <UserObject id="work-item-lanehead-1" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;pad CLI&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;cli&lt;/i&gt;&lt;br&gt; &lt;br&gt;the Mac (Homebrew perpetualsoftware/​tap/​pad)' tooltip='&lt;b&gt;pad CLI (cli)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; the Mac (Homebrew &lt;font face="Courier New"&gt;perpetualsoftware/​tap/​pad&lt;/font&gt;)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; pad &lt;font face="Courier New"&gt;--version&lt;/font&gt; answers; pad auth whoami names a user&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;rounded=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="492" width="190" height="142" as="geometry"/></mxCell></UserObject>
        <mxCell id="work-item-lane-2" value="" style="rounded=0;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;opacity=35;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="634" width="2210" height="146" as="geometry"/></mxCell>
        <UserObject id="work-item-lanehead-2" label="" tooltip="&lt;b&gt;Repo trackers and CHANGELOG (store)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; target-map, ROADMAP, plan tracker, CHANGELOG&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; the truth; Pad items link to them&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;fontSize=11;arcSize=8;rounded=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="634" width="190" height="146" as="geometry"/></mxCell></UserObject>
        <UserObject id="work-item-lanehead-2-shape" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;Repo trackers and CHANGELOG&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;store&lt;/i&gt;&lt;br&gt; &lt;br&gt;target-map, ROADMAP, plan tracker, CHANGELOG' tooltip="&lt;b&gt;Repo trackers and CHANGELOG (store)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; target-map, ROADMAP, plan tracker, CHANGELOG&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; the truth; Pad items link to them&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6e6e6;strokeColor=#4d4d4d;fontSize=11;arcSize=8;fontSize=10;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;verticalAlign=middle;spacingTop=16;spacingBottom=2;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="26" y="642" width="178" height="130" as="geometry"/></mxCell></UserObject>
        <UserObject id="work-item-s-find" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;1. find&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Runs the status mode (pad project dashboard), then finds the item for the work, or creates a task to the writing standard.&lt;br&gt; &lt;br&gt;&lt;i&gt;via CLI&lt;/i&gt;' tooltip="&lt;b&gt;1.1 find (Agent session)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Runs the status mode (pad project dashboard), then finds the item for the work, or creates a task to the writing standard.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Fails&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;no item found and none created&lt;/li&gt;&lt;li&gt;so the work is invisible&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;Look&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;pad project dashboard&lt;/li&gt;&lt;li&gt;pad item search&lt;/li&gt;&lt;/ul&gt;" tags="fails"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=12;spacingLeft=18;spacingRight=18;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="230" y="299.5" width="220" height="127" as="geometry"/></mxCell></UserObject>
        <mxCell id="work-item-n-find" value="&lt;b&gt;1. find&lt;/b&gt;&lt;br&gt; &lt;br&gt;&lt;b&gt;Fails&lt;/b&gt;&lt;br&gt;• no item found and none created&lt;br&gt;• so the work is invisible&lt;br&gt; &lt;br&gt;&lt;b&gt;Look&lt;/b&gt;&lt;br&gt;• pad project dashboard&lt;br&gt;• pad item search" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="192" y="828" width="296" height="137" as="geometry"/></mxCell>
        <UserObject id="work-item-s-create" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;2. create&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Creates the task with its template, priority, due date and parent, and an op-key so a retry does not create two.&lt;br&gt; &lt;br&gt;&lt;i&gt;via CLI&lt;/i&gt;' tooltip="&lt;b&gt;1.2 create (pad CLI)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Creates the task with its template, priority, due date and parent, and an op-key so a retry does not create two.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Writes:&lt;/b&gt; pad.db&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="530" y="506" width="220" height="114" as="geometry"/></mxCell></UserObject>
        <mxCell id="work-item-n-create" value="&lt;b&gt;2. create&lt;/b&gt;&lt;br&gt; &lt;br&gt;&lt;b&gt;Writes&lt;/b&gt;&lt;br&gt;• pad.db" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="492" y="828" width="296" height="72" as="geometry"/></mxCell>
        <UserObject id="work-item-s-claim" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;3. claim&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Claims the item (pad item claim) and sets it in-progress with a --comment that says why, item refs as [[REF]] links.&lt;br&gt; &lt;br&gt;&lt;i&gt;via CLI&lt;/i&gt;' tooltip="&lt;b&gt;1.3 claim (Agent session)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Claims the item (pad item claim) and sets it in-progress with a &lt;font face=&quot;Courier New&quot;&gt;--comment&lt;/font&gt; that says why, item refs as [[REF]] links.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Fails&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;font face=&quot;Courier New&quot;&gt;lease_held&lt;/font&gt;&lt;/li&gt;&lt;li&gt;so pick other work&lt;/li&gt;&lt;/ul&gt;" tags="fails"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=12;spacingLeft=18;spacingRight=18;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="830" y="299.5" width="220" height="127" as="geometry"/></mxCell></UserObject>
        <mxCell id="work-item-n-claim" value="&lt;b&gt;3. claim&lt;/b&gt;&lt;br&gt; &lt;br&gt;&lt;b&gt;Fails&lt;/b&gt;&lt;br&gt;• lease_held&lt;br&gt;• so pick other work" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="792" y="828" width="296" height="85" as="geometry"/></mxCell>
        <UserObject id="work-item-s-update" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;4. update&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Comments at the start, at each result and at each blocker, as bullets (What, Result, Evidence, Not verified, Next), time from date.&lt;br&gt; &lt;br&gt;&lt;i&gt;via CLI&lt;/i&gt;' tooltip="&lt;b&gt;1.4 update (Agent session)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Comments at the start, at each result and at each blocker, as bullets (What, Result, Evidence, Not verified, Next), time from date.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Writes:&lt;/b&gt; comments&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=12;spacingLeft=18;spacingRight=18;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="1130" y="293" width="220" height="140" as="geometry"/></mxCell></UserObject>
