        <UserObject id="flow-decision-mirror-back" label="‹ E2E page" link="data:page/id,end-to-end" tooltip="Back to this flow's E2E page"><mxCell style="rounded=1;html=1;fillColor=#ffffff;strokeColor=#666666;fontColor=#333333;fontSize=11;align=center;verticalAlign=middle;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="100" height="22" as="geometry"/></mxCell></UserObject>
        <UserObject id="decision-mirror-head" label="&lt;b&gt;5. Decisions mirrored read-only into Pad&lt;/b&gt; (custom)&lt;br&gt; &lt;br&gt;Every decision shows in Pad&amp;#x27;s Decisions collection while the repo record stays the truth.&lt;br&gt; &lt;br&gt;&lt;b&gt;Trigger:&lt;/b&gt; manual: just pad-decisions --apply, also run by the commit gate&lt;br&gt;&lt;b&gt;Runs on:&lt;/b&gt; Commit gate · &lt;b&gt;Owner:&lt;/b&gt; pad_decisions.py&lt;br&gt;&lt;b&gt;Budget:&lt;/b&gt; about 60 s for 110 items; a re-run with nothing changed writes nothing&lt;br&gt;&lt;b&gt;Depends on components:&lt;/b&gt; pad CLI, Decision records&lt;br&gt; &lt;br&gt;[back to Overview]" link="data:page/id,overview"><mxCell style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="50" width="1110" height="164" as="geometry"/></mxCell></UserObject>
        <mxCell id="decision-mirror-lane-0" value="" style="rounded=0;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;opacity=35;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="234" width="1110" height="168" as="geometry"/></mxCell>
        <UserObject id="decision-mirror-lanehead-0" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;pad_decisions.py&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;script&lt;/i&gt;&lt;br&gt; &lt;br&gt;skill-pad scripts/, run by a project&amp;#x27;s just pad-decisions' tooltip='&lt;b&gt;&lt;font face="Courier New"&gt;pad_decisions.py&lt;/font&gt; (script)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; skill-pad scripts/, run by a project&amp;#x27;s just pad-decisions&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; a second plan shows 0 to create and 0 to update; orphans listed&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;rounded=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="234" width="190" height="168" as="geometry"/></mxCell></UserObject>
        <mxCell id="decision-mirror-lane-1" value="" style="rounded=0;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=35;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="402" width="1110" height="148" as="geometry"/></mxCell>
        <UserObject id="decision-mirror-lanehead-1" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;pad CLI&lt;/b&gt;&lt;/span&gt;&lt;br&gt;&lt;i&gt;cli&lt;/i&gt;&lt;br&gt; &lt;br&gt;the Mac (Homebrew perpetualsoftware/​tap/​pad)' tooltip='&lt;b&gt;pad CLI (cli)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; the Mac (Homebrew &lt;font face="Courier New"&gt;perpetualsoftware/​tap/​pad&lt;/font&gt;)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; pad &lt;font face="Courier New"&gt;--version&lt;/font&gt; answers; pad auth whoami names a user&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;arcSize=8;rounded=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=8;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="402" width="190" height="148" as="geometry"/></mxCell></UserObject>
        <UserObject id="decision-mirror-s-read" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;1. read&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Reads the .kc ledger, the decision log&amp;#x27;s DL rows and, with --architecture, an architecture document&amp;#x27;s Key decisions bullets.&lt;br&gt; &lt;br&gt;&lt;i&gt;via file&lt;/i&gt;' tooltip="&lt;b&gt;5.1 read (&lt;font face=&quot;Courier New&quot;&gt;pad_decisions.py&lt;/font&gt;)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Reads the .kc ledger, the decision log&amp;#x27;s DL rows and, with &lt;font face=&quot;Courier New&quot;&gt;--architecture&lt;/font&gt;, an architecture document&amp;#x27;s Key decisions bullets.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Reads&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;decision log&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Courier New&quot;&gt;.kc/decisions.jsonl&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font face=&quot;Courier New&quot;&gt;ARCHITECTURE.md&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;Code:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;scripts/​pad_​decisions.​py&lt;/font&gt;:​&lt;font face=&quot;Courier New&quot;&gt;architecture_​items&lt;/font&gt;&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=1;absoluteArcSize=1;arcSize=36;spacingLeft=14;spacingRight=12;spacingTop=8;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="230" y="251" width="220" height="134" as="geometry"/></mxCell></UserObject>
        <mxCell id="decision-mirror-n-read" value='&lt;b&gt;1. read&lt;/b&gt;&lt;br&gt; &lt;br&gt;&lt;b&gt;Reads&lt;/b&gt;&lt;br&gt;• decision log&lt;br&gt;• .kc/decisions.jsonl&lt;br&gt;• ARCHITECTURE.md&lt;br&gt; &lt;br&gt;&lt;b&gt;Code&lt;/b&gt;&lt;br&gt;• &lt;font face="Courier New"&gt;scripts/​pad_​decisions.​py:​architecture_​items&lt;/font&gt;' style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="192" y="598" width="296" height="137" as="geometry"/></mxCell>
        <UserObject id="decision-mirror-s-match" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;2. match&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;• Matches each to a Pad item by decision_ref&lt;br&gt;• plans creates and body rewrites&lt;br&gt;• lists orphans (a renamed bullet) without changing them.&lt;br&gt; &lt;br&gt;&lt;i&gt;via CLI&lt;/i&gt;' tooltip='&lt;b&gt;5.2 match (&lt;font face="Courier New"&gt;pad_decisions.py&lt;/font&gt;)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Matches each to a Pad item by &lt;font face="Courier New"&gt;decision_ref&lt;/font&gt;; plans creates and body rewrites; lists orphans (a renamed bullet) without changing them.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Fails:&lt;/b&gt; a renamed ARCH bullet leaves an orphaned item&lt;/div&gt;&lt;div&gt;&lt;b&gt;Code:&lt;/b&gt; &lt;font face="Courier New"&gt;scripts/​pad_​decisions.​py&lt;/font&gt;:​orphans&lt;/div&gt;' tags="fails"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="530" y="248" width="220" height="140" as="geometry"/></mxCell></UserObject>
