        <UserObject id="bug-s-report" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;1. report&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;• Creates the bug with Seen, Evidence, Effect and Closure, and Cause, Options, Not verified when known&lt;br&gt;• section and order fields place it.&lt;br&gt; &lt;br&gt;&lt;i&gt;via CLI&lt;/i&gt;' tooltip="&lt;b&gt;3.1 report (Agent session)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Creates the bug with Seen, Evidence, Effect and Closure, and Cause, Options, Not verified when known; section and order fields place it.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Writes:&lt;/b&gt; bugs collection&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=12;spacingLeft=18;spacingRight=18;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="230" y="258.5" width="220" height="153" as="geometry"/></mxCell></UserObject>
        <mxCell id="bug-n-report" value="&lt;b&gt;1. report&lt;/b&gt;&lt;br&gt; &lt;br&gt;&lt;b&gt;Writes&lt;/b&gt;&lt;br&gt;• bugs collection" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="192" y="633" width="296" height="72" as="geometry"/></mxCell>
        <UserObject id="bug-s-work" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;2. work&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;The task that fixes it implements it (pad item implements TASK-n BUG-n).&lt;br&gt; &lt;br&gt;&lt;i&gt;via CLI&lt;/i&gt;' tooltip="&lt;b&gt;3.2 work (Agent session)&lt;/b&gt;&lt;br&gt;&lt;div&gt;The task that fixes it implements it (pad item implements TASK-n BUG-n).&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=12;spacingLeft=18;spacingRight=18;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="530" y="278" width="220" height="114" as="geometry"/></mxCell></UserObject>
        <UserObject id="bug-s-fix" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;3. fix&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;• Fixed in code with a test&lt;br&gt;• a fix not yet deployed stays in-progress, with a comment saying so.&lt;br&gt; &lt;br&gt;&lt;i&gt;via file&lt;/i&gt;' tooltip="&lt;b&gt;3.3 fix (Agent session)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Fixed in code with a test; a fix not yet deployed stays in-progress, with a comment saying so.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Fails&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;set fixed before the deploy&lt;/li&gt;&lt;li&gt;so the live system still fails&lt;/li&gt;&lt;/ul&gt;" tags="fails"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;shape=trapezoid;perimeter=trapezoidPerimeter;flipV=1;fixedSize=1;size=12;spacingLeft=18;spacingRight=18;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="830" y="271.5" width="220" height="127" as="geometry"/></mxCell></UserObject>
        <mxCell id="bug-n-fix" value="&lt;b&gt;3. fix&lt;/b&gt;&lt;br&gt; &lt;br&gt;&lt;b&gt;Fails&lt;/b&gt;&lt;br&gt;• set fixed before the deploy&lt;br&gt;• so the live system still fails" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fffbe6;strokeColor=#bf9000;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="792" y="633" width="296" height="85" as="geometry"/></mxCell>
        <UserObject id="bug-s-closed" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;4. closed&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;Fixed only when fixed and live, after a DONE comment with the evidence.&lt;br&gt; &lt;br&gt;&lt;i&gt;via CLI&lt;/i&gt;&lt;br&gt;&lt;b&gt;GATE: just item-check exits 0&lt;/b&gt;' tooltip="&lt;b&gt;3.4 closed (Agent session)&lt;/b&gt;&lt;br&gt;&lt;div&gt;Fixed only when fixed and live, after a DONE comment with the evidence.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Gate:&lt;/b&gt; just item-check exits 0&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;" tags="decision gate"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;strokeWidth=2;rhombus;align=center;verticalAlign=middle;spacingLeft=72;spacingRight=72;spacingTop=0;spacingLeft=90;spacingRight=90;spacingTop=0;spacingBottom=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="1130" y="233" width="360" height="204" as="geometry"/></mxCell></UserObject>
        <UserObject id="bug-s-export" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;5. export&lt;/b&gt;&lt;/span&gt;&lt;br&gt; &lt;br&gt;The next commit regenerates bug-tracker.md from Pad.&lt;br&gt; &lt;br&gt;&lt;i&gt;via CLI&lt;/i&gt;' tooltip='&lt;b&gt;3.5 export (Commit gate)&lt;/b&gt;&lt;br&gt;&lt;div&gt;The next commit regenerates &lt;font face="Courier New"&gt;bug-tracker.md&lt;/font&gt; from Pad.&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Code:&lt;/b&gt; &lt;font face="Courier New"&gt;scripts/​pad_​tracker.​py&lt;/font&gt;:​&lt;font face="Courier New"&gt;export_​text&lt;/font&gt;&lt;/div&gt;'><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=6;rounded=1;absoluteArcSize=1;arcSize=36;spacingLeft=14;spacingRight=12;spacingTop=8;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="1570" y="465" width="220" height="106" as="geometry"/></mxCell></UserObject>
