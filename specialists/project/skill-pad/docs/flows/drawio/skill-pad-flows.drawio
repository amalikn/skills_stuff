        <UserObject id="e2e-c-commit-gate" label='&lt;span style="font-size:125%"&gt;&lt;b&gt;Commit gate&lt;/b&gt;&lt;/span&gt;&lt;br&gt;script' tooltip="&lt;b&gt;Commit gate (script)&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Host:&lt;/b&gt; a project&amp;#x27;s just commit-gate (run by just commit-project)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Health:&lt;/b&gt; exits 0 before a commit&lt;/div&gt;" tags="kind-script group-project-repo flow-bug flow-tracker-export flow-decision-mirror flow-focus-export"><mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;arcSize=8;fontSize=11;verticalAlign=middle;spacingLeft=6;spacingRight=6;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="1052" y="1818" width="210" height="132" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-c-work-pad-cli-pad-server" label="" tooltip="&lt;b&gt;Pad server: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why:&lt;/b&gt; &lt;b&gt;A piece of work, visible in Pad from start to done&lt;/b&gt; depends on Pad server&lt;/div&gt;" tags="flow-work-item family-work connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=1;exitY=0.86;entryX=1;entryY=0.25;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-work" source="e2e-c-pad-cli" target="e2e-c-pad-server"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="922" y="1004"/><mxPoint x="922" y="1524"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-work-pad-cli-pad-web" label="" tooltip="&lt;b&gt;Pad web UI: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why:&lt;/b&gt; &lt;b&gt;An ask waits on the operator and blocks its work&lt;/b&gt; depends on Pad web UI&lt;/div&gt;" tags="flow-ask family-work connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=1;exitY=0.94;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-work" source="e2e-c-pad-cli" target="e2e-c-pad-web"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="898" y="1028"/><mxPoint x="898" y="1276"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-work-agent-pad-cli" label="" tooltip="&lt;b&gt;pad CLI: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why:&lt;/b&gt; &lt;b&gt;A bug from report to fixed and live&lt;/b&gt; depends on pad CLI&lt;/div&gt;" tags="flow-bug family-work connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=1;exitY=0.5;entryX=0;entryY=0.66;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-work" source="e2e-c-agent" target="e2e-c-pad-cli"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="500" y="1276"/><mxPoint x="500" y="944"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-work-commit-gate-tracker-files" label="" tooltip="&lt;b&gt;Generated trackers: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; Commit gate&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why:&lt;/b&gt; &lt;b&gt;A bug from report to fixed and live&lt;/b&gt; depends on Generated trackers&lt;/div&gt;" tags="flow-bug family-work connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=1;exitY=0.8636;entryX=1;entryY=0.2333;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-work" source="e2e-c-commit-gate" target="e2e-c-tracker-files"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1416" y="1932"/><mxPoint x="1416" y="2019"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-work-item-2" label="" tooltip="&lt;b&gt;1.2 A piece of work, visible in Pad from start to done: step 2 create&lt;/b&gt;&lt;br&gt;&lt;div&gt;Creates the task with its template, priority, due date and parent, and an op-key so a retry does not create two.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow):&lt;/b&gt; &lt;b&gt;1.1 find:&lt;/b&gt; Runs the status mode (pad project dashboard), then finds the item for the work, or creates a task to the writing standard.&lt;/div&gt;" tags="flow-work-item family-work step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.2895;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-work" source="e2e-c-agent" target="e2e-c-pad-cli"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="428" y="1228"/><mxPoint x="428" y="896"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-work-item-3" label="" tooltip='&lt;b&gt;1.3 A piece of work, visible in Pad from start to done: step 3 claim&lt;/b&gt;&lt;br&gt;&lt;div&gt;Claims the item (pad item claim) and sets it in-progress with a &lt;font face="Courier New"&gt;--comment&lt;/font&gt; that says why, item refs as [[REF]] links.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-work-item family-work step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.58;entryX=1;entryY=0.3947;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-work" source="e2e-c-pad-cli" target="e2e-c-agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="476" y="920"/><mxPoint x="476" y="1252"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-work-item-5" label="" tooltip="&lt;b&gt;1.5 A piece of work, visible in Pad from start to done: step 5 record&lt;/b&gt;&lt;br&gt;&lt;div&gt;The repo record is written first (tracker, CHANGELOG, decision record); Pad links to it.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Repo trackers and CHANGELOG&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow):&lt;/b&gt; &lt;b&gt;1.4 update:&lt;/b&gt; Comments at the start, at each result and at each blocker, as bullets (What, Result, Evidence, Not verified, Next), time from date.&lt;/div&gt;" tags="flow-work-item family-work step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.6053;entryX=0;entryY=0.2363;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-work" source="e2e-c-agent" target="e2e-c-repo-records"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="102" y="1300"/><mxPoint x="102" y="1860"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-work-item-6" label="" tooltip='&lt;b&gt;1.6 A piece of work, visible in Pad from start to done: step 6 done&lt;/b&gt;&lt;br&gt;&lt;div&gt;Adds the DONE or CLOSED comment, attaches logs, runs item-check, then sets the status with a one-line &lt;font face="Courier New"&gt;--comment&lt;/font&gt; pointing to it.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Repo trackers and CHANGELOG&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-work-item family-work step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-work" source="e2e-c-repo-records" target="e2e-c-agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="78" y="1884"/><mxPoint x="78" y="1276"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-ask-2" label="" tooltip="&lt;b&gt;2.2 An ask waits on the operator and blocks its work: step 2 block&lt;/b&gt;&lt;br&gt;&lt;div&gt;pad item block ASK-n TASK-m takes the task out of next and into stale.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow):&lt;/b&gt; &lt;b&gt;2.1 raise:&lt;/b&gt; Creates the ask (Question, Options with the recommended one, Blocks, Evidence) with kind, priority and due date.&lt;/div&gt;" tags="flow-ask family-work step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.0789;entryX=0;entryY=0.42;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-work" source="e2e-c-agent" target="e2e-c-pad-cli"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="1180"/><mxPoint x="380" y="872"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-ask-3" label="" tooltip="&lt;b&gt;2.3 An ask waits on the operator and blocks its work: step 3 answer&lt;/b&gt;&lt;br&gt;&lt;div&gt;Answers on the ask in the web UI or in the session chat.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;HTTP&lt;/li&gt;&lt;li&gt;chat&lt;/li&gt;&lt;/ul&gt;" tags="flow-ask family-work step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.26;entryX=1;entryY=0.15;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-work" source="e2e-c-pad-cli" target="e2e-c-operator"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-ask-4" label="" tooltip="&lt;b&gt;2.4 An ask waits on the operator and blocks its work: step 4 record&lt;/b&gt;&lt;br&gt;&lt;div&gt;The agent records the answer in the repo first (decision log, guidelines, ROADMAP).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Repo trackers and CHANGELOG&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;" tags="flow-ask family-work step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.65;entryX=0;entryY=0.7637;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-work" source="e2e-c-operator" target="e2e-c-repo-records"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="54" y="884"/><mxPoint x="54" y="1908"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-ask-5" label="" tooltip="&lt;b&gt;2.5 An ask waits on the operator and blocks its work: step 5 close&lt;/b&gt;&lt;br&gt;&lt;div&gt;Sets answer and status answered with a comment citing the record, then unblocks the task.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Repo trackers and CHANGELOG&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;" tags="flow-ask family-work step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.74;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-work" source="e2e-c-repo-records" target="e2e-c-pad-cli"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="524" y="1884"/><mxPoint x="524" y="968"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-bug-5" label="" tooltip="&lt;b&gt;3.5 A bug from report to fixed and live: step 5 export&lt;/b&gt;&lt;br&gt;&lt;div&gt;The next commit regenerates &lt;font face=&quot;Courier New&quot;&gt;bug-tracker.md&lt;/font&gt; from Pad.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Commit gate&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow)&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;3.1 report:&lt;/b&gt; Creates the bug with Seen, Evidence, Effect and Closure, and Cause, Options, Not verified when known; section and order fields place it.&lt;/li&gt;&lt;li&gt;&lt;b&gt;3.2 work:&lt;/b&gt; The task that fixes it implements it (pad item implements TASK-n BUG-n).&lt;/li&gt;&lt;li&gt;&lt;b&gt;3.3 fix:&lt;/b&gt; Fixed in code with a test; a fix not yet deployed stays in-progress, with a comment saying so.&lt;/li&gt;&lt;li&gt;&lt;b&gt;3.4 closed:&lt;/b&gt; Fixed only when fixed and live, after a DONE comment with the evidence.&lt;/li&gt;&lt;/ul&gt;" tags="flow-bug family-work step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1f4e9c;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.7105;entryX=0;entryY=0.6818;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-work" source="e2e-c-agent" target="e2e-c-commit-gate"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="452" y="1324"/><mxPoint x="452" y="1424"/><mxPoint x="850" y="1424"/><mxPoint x="850" y="1908"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-records-commit-gate-pad-cli" label="" tooltip="&lt;b&gt;pad CLI: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; Commit gate&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;Bug and feature trackers generated from Pad&lt;/b&gt; depends on pad CLI&lt;/li&gt;&lt;li&gt;&lt;b&gt;The operator&amp;#x27;s focus exported to the repo&lt;/b&gt; depends on pad CLI&lt;/li&gt;&lt;/ul&gt;" tags="flow-tracker-export flow-focus-export family-records connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=0;exitY=0.5;entryX=1;entryY=0.7;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-records" source="e2e-c-commit-gate" target="e2e-c-pad-cli"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="970" y="1884"/><mxPoint x="970" y="956"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-records-decisions-script-decision-records" label="" tooltip='&lt;b&gt;Decision records: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_decisions.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why:&lt;/b&gt; &lt;b&gt;Decisions mirrored read-only into Pad&lt;/b&gt; depends on Decision records&lt;/div&gt;' tags="flow-decision-mirror family-records connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=1;exitY=0.3;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-records" source="e2e-c-decisions-script" target="e2e-c-decision-records"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1488" y="656"/><mxPoint x="1488" y="1884"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-records-export-script-pad-cli" label="" tooltip="&lt;b&gt;pad CLI: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;pad_export.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;Bug and feature trackers generated from Pad&lt;/b&gt; depends on pad CLI&lt;/li&gt;&lt;li&gt;&lt;b&gt;The operator&amp;#x27;s focus exported to the repo&lt;/b&gt; depends on pad CLI&lt;/li&gt;&lt;/ul&gt;" tags="flow-tracker-export flow-focus-export family-records connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=0;exitY=0.5;entryX=1;entryY=0.06;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-records" source="e2e-c-export-script" target="e2e-c-pad-cli"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="826" y="452"/><mxPoint x="826" y="764"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-records-export-script-tracker-files" label="" tooltip='&lt;b&gt;Generated trackers: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_export.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why:&lt;/b&gt; &lt;b&gt;The operator&amp;#x27;s focus exported to the repo&lt;/b&gt; depends on Generated trackers&lt;/div&gt;' tags="flow-focus-export family-records connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=1;exitY=0.3;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-records" source="e2e-c-export-script" target="e2e-c-tracker-files"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1440" y="440"/><mxPoint x="1440" y="2043"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-tracker-export-2" label="" tooltip='&lt;b&gt;4.2 Bug and feature trackers generated from Pad: step 2 read&lt;/b&gt;&lt;br&gt;&lt;div&gt;Lists the collection (&lt;font face="Courier New"&gt;--all&lt;/font&gt; &lt;font face="Courier New"&gt;--full&lt;/font&gt;) and rebuilds each section&amp;#x27;s item tree; an item made in Pad renders its title, its body under it.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Commit gate&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_tracker.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Commit gate (no arrow):&lt;/b&gt; &lt;b&gt;4.1 gate:&lt;/b&gt; Runs just pad-trackers &lt;font face="Courier New"&gt;--apply&lt;/font&gt;.&lt;/div&gt;' tags="flow-tracker-export family-records step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.6818;entryX=1;entryY=0.7;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-records" source="e2e-c-commit-gate" target="e2e-c-tracker-script"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1416" y="1908"/><mxPoint x="1416" y="356"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-tracker-export-4" label="" tooltip='&lt;b&gt;4.4 Bug and feature trackers generated from Pad: step 4 stored&lt;/b&gt;&lt;br&gt;&lt;div&gt;The generated files are committed with the work.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_tracker.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Generated trackers&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in pad_tracker.py (no arrow):&lt;/b&gt; &lt;b&gt;4.3 write:&lt;/b&gt; Rewrites each generated block, keeping the hand-written text around it.&lt;/div&gt;' tags="flow-tracker-export family-records step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.3;entryX=1;entryY=0.7667;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-records" source="e2e-c-tracker-script" target="e2e-c-tracker-files"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1464" y="332"/><mxPoint x="1464" y="2067"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-decision-mirror-1" label="" tooltip='&lt;b&gt;5.1 Decisions mirrored read-only into Pad: step 1 read&lt;/b&gt;&lt;br&gt;&lt;div&gt;Reads the .kc ledger, the decision log&amp;#x27;s DL rows and, with &lt;font face="Courier New"&gt;--architecture&lt;/font&gt;, an architecture document&amp;#x27;s Key decisions bullets.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Commit gate&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_decisions.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;' tags="flow-decision-mirror family-records step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.1364;entryX=1;entryY=0.7;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-records" source="e2e-c-commit-gate" target="e2e-c-decisions-script"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1368" y="1836"/><mxPoint x="1368" y="680"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-decision-mirror-3" label="" tooltip='&lt;b&gt;5.3 Decisions mirrored read-only into Pad: step 3 write&lt;/b&gt;&lt;br&gt;&lt;div&gt;Creates or rewrites the items with bold labels (Serves, Decision, Reason or Detail, Source).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_decisions.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in pad_decisions.py (no arrow):&lt;/b&gt; &lt;b&gt;5.2 match:&lt;/b&gt; Matches each to a Pad item by &lt;font face="Courier New"&gt;decision_ref&lt;/font&gt;; plans creates and body rewrites; lists orphans (a renamed bullet) without changing them.&lt;/div&gt;' tags="flow-decision-mirror family-records step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.5;entryX=1;entryY=0.22;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-records" source="e2e-c-decisions-script" target="e2e-c-pad-cli"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1018" y="668"/><mxPoint x="1018" y="812"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-focus-export-1" label="" tooltip='&lt;b&gt;6.1 The operator&amp;#x27;s focus exported to the repo: step 1 read&lt;/b&gt;&lt;br&gt;&lt;div&gt;Reads the workspace, skipping conventions, playbooks, bugs, feature requests, tech debt and decisions.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Commit gate&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_export.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-focus-export family-records step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#1b7a3a;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.3182;entryX=1;entryY=0.7;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-records" source="e2e-c-commit-gate" target="e2e-c-export-script"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1392" y="1860"/><mxPoint x="1392" y="464"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-standard-pad-cli-baseline" label="" tooltip="&lt;b&gt;Convention baselines: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why:&lt;/b&gt; &lt;b&gt;Conventions applied from the central baseline&lt;/b&gt; depends on Convention baselines&lt;/div&gt;" tags="flow-conventions-apply family-standard connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=1;exitY=0.78;entryX=1;entryY=0.2333;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-standard" source="e2e-c-pad-cli" target="e2e-c-baseline"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="946" y="980"/><mxPoint x="946" y="1860"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-standard-layout-scripts-pad-cli" label="" tooltip="&lt;b&gt;pad CLI: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;pad_format_spec.py&lt;/font&gt; and &lt;font face=&quot;Courier New&quot;&gt;pad_rewrite.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;Bodies laid out to the templates, words unchanged&lt;/b&gt; depends on pad CLI&lt;/li&gt;&lt;li&gt;&lt;b&gt;References made clickable&lt;/b&gt; depends on pad CLI&lt;/li&gt;&lt;/ul&gt;" tags="flow-layout-pass flow-links-pass family-standard connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=0;exitY=0.2143;entryX=1;entryY=0.54;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-standard" source="e2e-c-layout-scripts" target="e2e-c-pad-cli"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1018" y="1252"/><mxPoint x="1018" y="908"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-standard-links-script-pad-cli" label="" tooltip="&lt;b&gt;pad CLI: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; &lt;font face=&quot;Courier New&quot;&gt;pad_links.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;Bodies laid out to the templates, words unchanged&lt;/b&gt; depends on pad CLI&lt;/li&gt;&lt;li&gt;&lt;b&gt;References made clickable&lt;/b&gt; depends on pad CLI&lt;/li&gt;&lt;/ul&gt;" tags="flow-layout-pass flow-links-pass family-standard connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=0;exitY=0.4167;entryX=1;entryY=0.62;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-standard" source="e2e-c-links-script" target="e2e-c-pad-cli"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="994" y="1548"/><mxPoint x="994" y="932"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-conventions-apply-1" label="" tooltip='&lt;b&gt;7.1 Conventions applied from the central baseline: step 1 read&lt;/b&gt;&lt;br&gt;&lt;div&gt;Loads the baseline (apn-baseline.toml or an adapted file) and fills {project} and {trackers}; the trackers text is read from the workspace&amp;#x27;s own trackers-truth first.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_conventions.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;' tags="flow-conventions-apply family-standard step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.1842;entryX=0;entryY=0.3;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-standard" source="e2e-c-agent" target="e2e-c-conventions-script"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="404" y="1204"/><mxPoint x="404" y="548"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-conventions-apply-3" label="" tooltip='&lt;b&gt;7.3 Conventions applied from the central baseline: step 3 apply&lt;/b&gt;&lt;br&gt;&lt;div&gt;Writes with &lt;font face="Courier New"&gt;--apply&lt;/font&gt;; a second plan must show 0 changes.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_conventions.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in pad_conventions.py (no arrow):&lt;/b&gt; &lt;b&gt;7.2 plan:&lt;/b&gt; Plans same, update or create per convention (the startup template&amp;#x27;s four are rewritten in place).&lt;/div&gt;' tags="flow-conventions-apply family-standard step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.7;entryX=1;entryY=0.14;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-standard" source="e2e-c-conventions-script" target="e2e-c-pad-cli"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="572"/><mxPoint x="850" y="788"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-layout-pass-1" label="" tooltip='&lt;b&gt;8.1 Bodies laid out to the templates, words unchanged: step 1 spec&lt;/b&gt;&lt;br&gt;&lt;div&gt;Reads every body and writes a spec that bolds labels and joins hard wraps, with each item&amp;#x27;s seq.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_format_spec.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_rewrite.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-layout-pass family-standard step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.9211;entryX=0;entryY=0.7857;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-standard" source="e2e-c-agent" target="e2e-c-layout-scripts"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="380" y="1372"/><mxPoint x="380" y="1448"/><mxPoint x="826" y="1448"/><mxPoint x="826" y="1300"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-layout-pass-2" label="" tooltip='&lt;b&gt;8.2 Bodies laid out to the templates, words unchanged: step 2 review&lt;/b&gt;&lt;br&gt;&lt;div&gt;just spec-words checks every body in the spec keeps every word of the item&amp;#x27;s current body (labels may be added), before applying.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_format_spec.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_rewrite.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_item_check.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_spec_words.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-layout-pass family-standard step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.7857;entryX=1;entryY=0.2143;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-standard" source="e2e-c-layout-scripts" target="e2e-c-check-script"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1296" y="1300"/><mxPoint x="1296" y="1656"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-layout-pass-3" label="" tooltip='&lt;b&gt;8.3 Bodies laid out to the templates, words unchanged: step 3 rewrite&lt;/b&gt;&lt;br&gt;&lt;div&gt;Applies the spec, each write guarded by seq.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_item_check.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_spec_words.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_format_spec.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_rewrite.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-layout-pass family-standard step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.7857;entryX=1;entryY=0.2143;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-standard" source="e2e-c-check-script" target="e2e-c-layout-scripts"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1344" y="1704"/><mxPoint x="1344" y="1252"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-layout-pass-4" label="" tooltip='&lt;b&gt;8.4 Bodies laid out to the templates, words unchanged: step 4 check&lt;/b&gt;&lt;br&gt;&lt;div&gt;item-check over the workspace reports what still lacks a required label or a closing comment.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_format_spec.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_rewrite.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_item_check.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_spec_words.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-layout-pass family-standard step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-standard" source="e2e-c-layout-scripts" target="e2e-c-check-script"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1320" y="1276"/><mxPoint x="1320" y="1680"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-links-pass-1" label="" tooltip='&lt;b&gt;9.1 References made clickable: step 1 index&lt;/b&gt;&lt;br&gt;&lt;div&gt;Lists every item ref and every &lt;font face="Courier New"&gt;decision_ref&lt;/font&gt; of the Decisions mirror.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_links.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-links-pass family-standard step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#6a3fa0;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.8158;entryX=0;entryY=0.75;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-standard" source="e2e-c-agent" target="e2e-c-links-script"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="428" y="1348"/><mxPoint x="428" y="1472"/><mxPoint x="826" y="1472"/><mxPoint x="826" y="1572"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-operations-backup-timer-pad-db" label="" tooltip="&lt;b&gt;Pad data (pad.db, attachments): not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; Nightly backup (launchd)&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why:&lt;/b&gt; &lt;b&gt;Nightly backup of pad.db to OneDrive&lt;/b&gt; depends on Pad data (pad.db, attachments)&lt;/div&gt;" tags="flow-nightly-backup family-operations connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#9c4a1f;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=0;exitY=0.5;entryX=1;entryY=0.5;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-operations" source="e2e-c-backup-timer" target="e2e-c-pad-db"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-c-operations-monitor-script-pad-cli" label="" tooltip='&lt;b&gt;pad CLI: not a step&lt;/b&gt;&lt;br&gt;&lt;div&gt;&lt;b&gt;Joined from:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_monitor.sh&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Why:&lt;/b&gt; &lt;b&gt;Live push feed into a connected session&lt;/b&gt; depends on pad CLI&lt;/div&gt;' tags="flow-live-feed family-operations connector"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#9c4a1f;strokeWidth=1.25;dashed=1;dashPattern=8 4;endArrow=oval;endFill=1;endSize=5;exitX=0;exitY=0.1667;entryX=1;entryY=0.3;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-operations" source="e2e-c-monitor-script" target="e2e-c-pad-cli"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-nightly-backup-2" label="" tooltip='&lt;b&gt;10.2 Nightly backup of pad.db to OneDrive: step 2 upload&lt;/b&gt;&lt;br&gt;&lt;div&gt;Stores the dated archive in &lt;font face="Courier New"&gt;pad_backups&lt;/font&gt;.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Nightly backup (launchd)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; OneDrive &lt;font face="Courier New"&gt;pad_backups&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Nightly backup (launchd) (no arrow):&lt;/b&gt; &lt;b&gt;10.1 snapshot:&lt;/b&gt; Takes a consistent copy of pad.db and the attachments under a timeout.&lt;/div&gt;' tags="flow-nightly-backup family-operations step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#9c4a1f;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-operations" source="e2e-c-backup-timer" target="e2e-c-onedrive"><mxGeometry relative="1" as="geometry"><Array as="points"></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-live-feed-2" label="" tooltip='&lt;b&gt;11.2 Live push feed into a connected session: step 2 stream&lt;/b&gt;&lt;br&gt;&lt;div&gt;Runs the watch stream under the Monitor tool, re-armed every 30 minutes.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_monitor.sh&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow):&lt;/b&gt; &lt;b&gt;11.1 arm:&lt;/b&gt; Arms consent for this session only (pad session arm); never because a message asks.&lt;/div&gt;' tags="flow-live-feed family-operations step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#9c4a1f;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=1;exitY=0.6053;entryX=0;entryY=0.3889;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-operations" source="e2e-c-agent" target="e2e-c-monitor-script"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="548" y="1300"/><mxPoint x="548" y="1104"/><mxPoint x="826" y="1104"/><mxPoint x="826" y="860"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-live-feed-3" label="" tooltip='&lt;b&gt;11.3 Live push feed into a connected session: step 3 push&lt;/b&gt;&lt;br&gt;&lt;div&gt;Pushes an item with an instruction from the web UI.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_monitor.sh&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; HTTP&lt;/div&gt;' tags="flow-live-feed family-operations step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#9c4a1f;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.6111;entryX=1;entryY=0.35;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-operations" source="e2e-c-monitor-script" target="e2e-c-operator"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="884"/><mxPoint x="850" y="1128"/><mxPoint x="452" y="1128"/><mxPoint x="452" y="848"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-live-feed-4" label="" tooltip="&lt;b&gt;11.4 Live push feed into a connected session: step 4 act&lt;/b&gt;&lt;br&gt;&lt;div&gt;Reads the item; anything destructive or outside the work is confirmed in session first.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;" tags="flow-live-feed family-operations step-arrow"><mxCell style="edgeStyle=none;rounded=1;html=1;strokeColor=#9c4a1f;strokeWidth=2;endArrow=classic;endFill=1;endSize=6;jumpStyle=arc;jumpSize=6;exitX=0;exitY=0.85;entryX=0;entryY=0.3947;exitPerimeter=0;entryPerimeter=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" edge="1" parent="e2e-L-operations" source="e2e-c-operator" target="e2e-c-agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="102" y="908"/><mxPoint x="102" y="1252"/></Array></mxGeometry></mxCell></UserObject>
        <UserObject id="e2e-a-work-item-2-l" label="&lt;b&gt;1.2&lt;/b&gt;" tooltip="&lt;b&gt;1.2 A piece of work, visible in Pad from start to done: step 2 create&lt;/b&gt;&lt;br&gt;&lt;div&gt;Creates the task with its template, priority, due date and parent, and an op-key so a retry does not create two.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow):&lt;/b&gt; &lt;b&gt;1.1 find:&lt;/b&gt; Runs the status mode (pad project dashboard), then finds the item for the work, or creates a task to the writing standard.&lt;/div&gt;" tags="flow-work-item family-work step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-work"><mxGeometry x="409" y="1054" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-work-item-3-l" label="&lt;b&gt;1.3&lt;/b&gt;" tooltip='&lt;b&gt;1.3 A piece of work, visible in Pad from start to done: step 3 claim&lt;/b&gt;&lt;br&gt;&lt;div&gt;Claims the item (pad item claim) and sets it in-progress with a &lt;font face="Courier New"&gt;--comment&lt;/font&gt; that says why, item refs as [[REF]] links.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-work-item family-work step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-work"><mxGeometry x="457" y="1078" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-work-item-5-l" label="&lt;b&gt;1.5&lt;/b&gt;" tooltip="&lt;b&gt;1.5 A piece of work, visible in Pad from start to done: step 5 record&lt;/b&gt;&lt;br&gt;&lt;div&gt;The repo record is written first (tracker, CHANGELOG, decision record); Pad links to it.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Repo trackers and CHANGELOG&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow):&lt;/b&gt; &lt;b&gt;1.4 update:&lt;/b&gt; Comments at the start, at each result and at each blocker, as bullets (What, Result, Evidence, Not verified, Next), time from date.&lt;/div&gt;" tags="flow-work-item family-work step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-work"><mxGeometry x="83" y="1572" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-work-item-6-l" label="&lt;b&gt;1.6&lt;/b&gt;" tooltip='&lt;b&gt;1.6 A piece of work, visible in Pad from start to done: step 6 done&lt;/b&gt;&lt;br&gt;&lt;div&gt;Adds the DONE or CLOSED comment, attaches logs, runs item-check, then sets the status with a one-line &lt;font face="Courier New"&gt;--comment&lt;/font&gt; pointing to it.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Repo trackers and CHANGELOG&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-work-item family-work step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-work"><mxGeometry x="59" y="1663.2" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-ask-2-l" label="&lt;b&gt;2.2&lt;/b&gt;" tooltip="&lt;b&gt;2.2 An ask waits on the operator and blocks its work: step 2 block&lt;/b&gt;&lt;br&gt;&lt;div&gt;pad item block ASK-n TASK-m takes the task out of next and into stale.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow):&lt;/b&gt; &lt;b&gt;2.1 raise:&lt;/b&gt; Creates the ask (Question, Options with the recommended one, Blocks, Evidence) with kind, priority and due date.&lt;/div&gt;" tags="flow-ask family-work step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-work"><mxGeometry x="361" y="1018" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-ask-3-l" label="&lt;b&gt;2.3&lt;/b&gt;" tooltip="&lt;b&gt;2.3 An ask waits on the operator and blocks its work: step 3 answer&lt;/b&gt;&lt;br&gt;&lt;div&gt;Answers on the ask in the web UI or in the session chat.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;HTTP&lt;/li&gt;&lt;li&gt;chat&lt;/li&gt;&lt;/ul&gt;" tags="flow-ask family-work step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-work"><mxGeometry x="445" y="816" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-ask-4-l" label="&lt;b&gt;2.4&lt;/b&gt;" tooltip="&lt;b&gt;2.4 An ask waits on the operator and blocks its work: step 4 record&lt;/b&gt;&lt;br&gt;&lt;div&gt;The agent records the answer in the repo first (decision log, guidelines, ROADMAP).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Repo trackers and CHANGELOG&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;" tags="flow-ask family-work step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-work"><mxGeometry x="35" y="1388" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-ask-5-l" label="&lt;b&gt;2.5&lt;/b&gt;" tooltip="&lt;b&gt;2.5 An ask waits on the operator and blocks its work: step 5 close&lt;/b&gt;&lt;br&gt;&lt;div&gt;Sets answer and status answered with a comment citing the record, then unblocks the task.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Repo trackers and CHANGELOG&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;" tags="flow-ask family-work step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-work"><mxGeometry x="505" y="1555.4" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-bug-5-l" label="&lt;b&gt;3.5&lt;/b&gt;" tooltip="&lt;b&gt;3.5 A bug from report to fixed and live: step 5 export&lt;/b&gt;&lt;br&gt;&lt;div&gt;The next commit regenerates &lt;font face=&quot;Courier New&quot;&gt;bug-tracker.md&lt;/font&gt; from Pad.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Commit gate&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow)&lt;/b&gt;&lt;/div&gt;&lt;ul style='margin:2px 0 2px 0;padding-left:16px;'&gt;&lt;li&gt;&lt;b&gt;3.1 report:&lt;/b&gt; Creates the bug with Seen, Evidence, Effect and Closure, and Cause, Options, Not verified when known; section and order fields place it.&lt;/li&gt;&lt;li&gt;&lt;b&gt;3.2 work:&lt;/b&gt; The task that fixes it implements it (pad item implements TASK-n BUG-n).&lt;/li&gt;&lt;li&gt;&lt;b&gt;3.3 fix:&lt;/b&gt; Fixed in code with a test; a fix not yet deployed stays in-progress, with a comment saying so.&lt;/li&gt;&lt;li&gt;&lt;b&gt;3.4 closed:&lt;/b&gt; Fixed only when fixed and live, after a DONE comment with the evidence.&lt;/li&gt;&lt;/ul&gt;" tags="flow-bug family-work step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1f4e9c;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-work"><mxGeometry x="831" y="1658" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-tracker-export-2-l" label="&lt;b&gt;4.2&lt;/b&gt;" tooltip='&lt;b&gt;4.2 Bug and feature trackers generated from Pad: step 2 read&lt;/b&gt;&lt;br&gt;&lt;div&gt;Lists the collection (&lt;font face="Courier New"&gt;--all&lt;/font&gt; &lt;font face="Courier New"&gt;--full&lt;/font&gt;) and rebuilds each section&amp;#x27;s item tree; an item made in Pad renders its title, its body under it.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Commit gate&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_tracker.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Commit gate (no arrow):&lt;/b&gt; &lt;b&gt;4.1 gate:&lt;/b&gt; Runs just pad-trackers &lt;font face="Courier New"&gt;--apply&lt;/font&gt;.&lt;/div&gt;' tags="flow-tracker-export family-records step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-records"><mxGeometry x="1397" y="1124" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-tracker-export-4-l" label="&lt;b&gt;4.4&lt;/b&gt;" tooltip='&lt;b&gt;4.4 Bug and feature trackers generated from Pad: step 4 stored&lt;/b&gt;&lt;br&gt;&lt;div&gt;The generated files are committed with the work.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_tracker.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Generated trackers&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in pad_tracker.py (no arrow):&lt;/b&gt; &lt;b&gt;4.3 write:&lt;/b&gt; Rewrites each generated block, keeping the hand-written text around it.&lt;/div&gt;' tags="flow-tracker-export family-records step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-records"><mxGeometry x="1445" y="1191.5" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-decision-mirror-1-l" label="&lt;b&gt;5.1&lt;/b&gt;" tooltip='&lt;b&gt;5.1 Decisions mirrored read-only into Pad: step 1 read&lt;/b&gt;&lt;br&gt;&lt;div&gt;Reads the .kc ledger, the decision log&amp;#x27;s DL rows and, with &lt;font face="Courier New"&gt;--architecture&lt;/font&gt;, an architecture document&amp;#x27;s Key decisions bullets.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Commit gate&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_decisions.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;' tags="flow-decision-mirror family-records step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-records"><mxGeometry x="1349" y="1250" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-decision-mirror-3-l" label="&lt;b&gt;5.3&lt;/b&gt;" tooltip='&lt;b&gt;5.3 Decisions mirrored read-only into Pad: step 3 write&lt;/b&gt;&lt;br&gt;&lt;div&gt;Creates or rewrites the items with bold labels (Serves, Decision, Reason or Detail, Source).&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_decisions.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in pad_decisions.py (no arrow):&lt;/b&gt; &lt;b&gt;5.2 match:&lt;/b&gt; Matches each to a Pad item by &lt;font face="Courier New"&gt;decision_ref&lt;/font&gt;; plans creates and body rewrites; lists orphans (a renamed bullet) without changing them.&lt;/div&gt;' tags="flow-decision-mirror family-records step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-records"><mxGeometry x="886" y="804" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-focus-export-1-l" label="&lt;b&gt;6.1&lt;/b&gt;" tooltip='&lt;b&gt;6.1 The operator&amp;#x27;s focus exported to the repo: step 1 read&lt;/b&gt;&lt;br&gt;&lt;div&gt;Reads the workspace, skipping conventions, playbooks, bugs, feature requests, tech debt and decisions.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Commit gate&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_export.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-focus-export family-records step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#1b7a3a;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-records"><mxGeometry x="1373" y="1154" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-conventions-apply-1-l" label="&lt;b&gt;7.1&lt;/b&gt;" tooltip='&lt;b&gt;7.1 Conventions applied from the central baseline: step 1 read&lt;/b&gt;&lt;br&gt;&lt;div&gt;Loads the baseline (apn-baseline.toml or an adapted file) and fills {project} and {trackers}; the trackers text is read from the workspace&amp;#x27;s own trackers-truth first.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_conventions.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;' tags="flow-conventions-apply family-standard step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-standard"><mxGeometry x="385" y="966.4" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-conventions-apply-3-l" label="&lt;b&gt;7.3&lt;/b&gt;" tooltip='&lt;b&gt;7.3 Conventions applied from the central baseline: step 3 apply&lt;/b&gt;&lt;br&gt;&lt;div&gt;Writes with &lt;font face="Courier New"&gt;--apply&lt;/font&gt;; a second plan must show 0 changes.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_conventions.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; pad CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in pad_conventions.py (no arrow):&lt;/b&gt; &lt;b&gt;7.2 plan:&lt;/b&gt; Plans same, update or create per convention (the startup template&amp;#x27;s four are rewritten in place).&lt;/div&gt;' tags="flow-conventions-apply family-standard step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-standard"><mxGeometry x="831" y="672" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-layout-pass-1-l" label="&lt;b&gt;8.1&lt;/b&gt;" tooltip='&lt;b&gt;8.1 Bodies laid out to the templates, words unchanged: step 1 spec&lt;/b&gt;&lt;br&gt;&lt;div&gt;Reads every body and writes a spec that bolds labels and joins hard wraps, with each item&amp;#x27;s seq.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_format_spec.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_rewrite.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-layout-pass family-standard step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#f4f6f9;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-standard"><mxGeometry x="584" y="1440" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-layout-pass-2-l" label="&lt;b&gt;8.2&lt;/b&gt;" tooltip='&lt;b&gt;8.2 Bodies laid out to the templates, words unchanged: step 2 review&lt;/b&gt;&lt;br&gt;&lt;div&gt;just spec-words checks every body in the spec keeps every word of the item&amp;#x27;s current body (labels may be added), before applying.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_format_spec.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_rewrite.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_item_check.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_spec_words.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-layout-pass family-standard step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-standard"><mxGeometry x="1277" y="1470" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-layout-pass-3-l" label="&lt;b&gt;8.3&lt;/b&gt;" tooltip='&lt;b&gt;8.3 Bodies laid out to the templates, words unchanged: step 3 rewrite&lt;/b&gt;&lt;br&gt;&lt;div&gt;Applies the spec, each write guarded by seq.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_item_check.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_spec_words.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_format_spec.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_rewrite.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-layout-pass family-standard step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-standard"><mxGeometry x="1325" y="1470" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-layout-pass-4-l" label="&lt;b&gt;8.4&lt;/b&gt;" tooltip='&lt;b&gt;8.4 Bodies laid out to the templates, words unchanged: step 4 check&lt;/b&gt;&lt;br&gt;&lt;div&gt;item-check over the workspace reports what still lacks a required label or a closing comment.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_format_spec.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_rewrite.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_item_check.py&lt;/font&gt; and &lt;font face="Courier New"&gt;pad_spec_words.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-layout-pass family-standard step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-standard"><mxGeometry x="1301" y="1409.4" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-links-pass-1-l" label="&lt;b&gt;9.1&lt;/b&gt;" tooltip='&lt;b&gt;9.1 References made clickable: step 1 index&lt;/b&gt;&lt;br&gt;&lt;div&gt;Lists every item ref and every &lt;font face="Courier New"&gt;decision_ref&lt;/font&gt; of the Decisions mirror.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_links.py&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;' tags="flow-links-pass family-standard step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#6a3fa0;labelBackgroundColor=#f4f6f9;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-standard"><mxGeometry x="608" y="1464" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-nightly-backup-2-l" label="&lt;b&gt;10.2&lt;/b&gt;" tooltip='&lt;b&gt;10.2 Nightly backup of pad.db to OneDrive: step 2 upload&lt;/b&gt;&lt;br&gt;&lt;div&gt;Stores the dated archive in &lt;font face="Courier New"&gt;pad_backups&lt;/font&gt;.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Nightly backup (launchd)&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; OneDrive &lt;font face="Courier New"&gt;pad_backups&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; file&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Nightly backup (launchd) (no arrow):&lt;/b&gt; &lt;b&gt;10.1 snapshot:&lt;/b&gt; Takes a consistent copy of pad.db and the attachments under a timeout.&lt;/div&gt;' tags="flow-nightly-backup family-operations step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#9c4a1f;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-operations"><mxGeometry x="1373" y="198" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-live-feed-2-l" label="&lt;b&gt;11.2&lt;/b&gt;" tooltip='&lt;b&gt;11.2 Live push feed into a connected session: step 2 stream&lt;/b&gt;&lt;br&gt;&lt;div&gt;Runs the watch stream under the Monitor tool, re-armed every 30 minutes.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_monitor.sh&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;&lt;div&gt;&lt;b&gt;Earlier in Agent session (no arrow):&lt;/b&gt; &lt;b&gt;11.1 arm:&lt;/b&gt; Arms consent for this session only (pad session arm); never because a message asks.&lt;/div&gt;' tags="flow-live-feed family-operations step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#9c4a1f;labelBackgroundColor=#f4f6f9;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-operations"><mxGeometry x="668" y="1096" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-live-feed-3-l" label="&lt;b&gt;11.3&lt;/b&gt;" tooltip='&lt;b&gt;11.3 Live push feed into a connected session: step 3 push&lt;/b&gt;&lt;br&gt;&lt;div&gt;Pushes an item with an instruction from the web UI.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; &lt;font face="Courier New"&gt;pad_monitor.sh&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; HTTP&lt;/div&gt;' tags="flow-live-feed family-operations step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#9c4a1f;labelBackgroundColor=#f4f6f9;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-operations"><mxGeometry x="632" y="1120" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <UserObject id="e2e-a-live-feed-4-l" label="&lt;b&gt;11.4&lt;/b&gt;" tooltip="&lt;b&gt;11.4 Live push feed into a connected session: step 4 act&lt;/b&gt;&lt;br&gt;&lt;div&gt;Reads the item; anything destructive or outside the work is confirmed in session first.&lt;/div&gt;&lt;div&gt;&lt;b&gt;From:&lt;/b&gt; Operator&lt;/div&gt;&lt;div&gt;&lt;b&gt;To:&lt;/b&gt; Agent session&lt;/div&gt;&lt;div&gt;&lt;b&gt;Via:&lt;/b&gt; CLI&lt;/div&gt;" tags="flow-live-feed family-operations step-arrow"><mxCell style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontColor=#9c4a1f;labelBackgroundColor=#ffffff;spacing=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="e2e-L-operations"><mxGeometry x="83" y="1072" width="38" height="16" as="geometry"/></mxCell></UserObject>
        <mxCell id="e2e-leg-title" value="&lt;b&gt;Legend: flow families&lt;/b&gt; (one layer each)" style="text;html=1;align=left;fontSize=14;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="2146" width="600" height="24" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-work-s" value="" style="rounded=0;html=1;fillColor=#1f4e9c;strokeColor=none;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="2190" width="40" height="3" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-work-t" value="&lt;b&gt;Work items:&lt;/b&gt; A piece of work, visible in Pad from start to done; An ask waits on the operator and blocks its work; A bug from report to fixed and live" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="70" y="2180" width="1662" height="24" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-records-s" value="" style="rounded=0;html=1;fillColor=#1b7a3a;strokeColor=none;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="2218" width="40" height="3" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-records-t" value="&lt;b&gt;Records:&lt;/b&gt; Bug and feature trackers generated from Pad; Decisions mirrored read-only into Pad; The operator&amp;#x27;s focus exported to the repo" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="70" y="2208" width="1662" height="24" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-standard-s" value="" style="rounded=0;html=1;fillColor=#6a3fa0;strokeColor=none;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="2246" width="40" height="3" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-standard-t" value="&lt;b&gt;Writing standard:&lt;/b&gt; Conventions applied from the central baseline; Bodies laid out to the templates, words unchanged; References made clickable" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="70" y="2236" width="1662" height="24" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-operations-s" value="" style="rounded=0;html=1;fillColor=#9c4a1f;strokeColor=none;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="2274" width="40" height="3" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-operations-t" value="&lt;b&gt;Operations:&lt;/b&gt; Nightly backup of pad.db to OneDrive; Live push feed into a connected session" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="70" y="2264" width="1662" height="24" as="geometry"/></mxCell>
        <mxCell id="e2e-leg-solid" value="&lt;b&gt;Solid arrow, label x.y:&lt;/b&gt; flow x (its number on the Overview) moves to the component acting in its step y; x.1 starts at the component the flow runs on, and a step done by the same component as the step before has no arrow. &lt;b&gt;Dashed line, dot end:&lt;/b&gt; not a step; the flow runs on, is owned by or depends on that component. Hover an arrow for what happens. Arcs mark crossings." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=12;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="2298" width="1712" height="40" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-title" value="&lt;b&gt;Shapes on this page&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="2354" width="300" height="24" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-person" value="" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;outlineConnect=0;fillColor=#ffffff;strokeColor=#333333;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="44" y="2384" width="22" height="36" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-person-t" value="Person: who starts or approves (the figure marks the box)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="100" y="2384" width="240" height="36" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-process" value="" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;rounded=0;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="350" y="2384" width="70" height="36" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-process-t" value="Process: a step that does work" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="430" y="2384" width="240" height="36" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-stored-data" value="" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="680" y="2384" width="70" height="36" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-stored-data-t" value="Stored data: a store that persists" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="760" y="2384" width="240" height="36" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-delay" value="" style="whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;shape=delay;spacingRight=24;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="20" y="2430" width="70" height="36" as="geometry"/></mxCell>
        <mxCell id="e2e-shp-delay-t" value="Delay: waits for time (a timer, a deadline)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;movable=0;resizable=0;rotatable=0;bendable=0;editable=0;deletable=0;" vertex="1" parent="1"><mxGeometry x="100" y="2430" width="240" height="36" as="geometry"/></mxCell>
