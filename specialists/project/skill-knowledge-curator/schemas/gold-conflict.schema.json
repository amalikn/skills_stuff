{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kc/gold-conflict",
  "title": "Labelled real conflict (kc recall --labels), written blind to kc output",
  "type": "object",
  "required": ["id", "kind", "severity", "a", "b"],
  "properties": {
    "id": {"type": "string"},
    "kind": {"enum": ["cross-file", "time-evolution", "within-file", "authority"]},
    "severity": {"enum": ["P0", "P1", "P2"]},
    "confidence": {"enum": ["high", "medium", "low"]},
    "excluded": {"type": "string", "description": "Why review dropped this label; it stays recorded and uncounted."},
    "a": {"$ref": "#/$defs/side"},
    "b": {"$ref": "#/$defs/side"}
  },
  "$defs": {
    "side": {
      "type": "object",
      "required": ["path", "line"],
      "properties": {"path": {"type": "string"}, "line": {"type": "integer", "minimum": 1}, "quote": {"type": "string"}}
    }
  }
}
