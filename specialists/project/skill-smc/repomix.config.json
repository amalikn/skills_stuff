{
  "output": {
    "filePath": ".ai-context/governance-pack.md",
    "style": "markdown"
  },
  "include": [
    "AGENTS.md",
    "CLAUDE.md",
    "AI_NAVIGATION.md",
    "README.md",
    "ARCHITECTURE.md",
    "SKILL.md",
    "RUNBOOK.md",
